{
  "name": "neyvia-desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "bin": {
    "neyvia": "scripts/neyvia-cli.mjs",
    "fluxio": "scripts/fluxio-cli.mjs"
  },
  "scripts": {
    "verify:proofs": "node scripts/fluxio-cli.mjs verify",
    "release:slim": "node scripts/prepare_slim_release.mjs",
    "verify:slim": "node scripts/verify_T6.mjs",
    "neyvia": "python scripts/launch_neyvia.py",
    "fluxio": "python scripts/launch_fluxio.py",
    "start": "python scripts/launch_neyvia.py",
    "frontend:dev": "vite --config vite.config.mjs",
    "record:neyvia": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/record_neyvia_session.ps1",
    "frontend:build": "vite build --config vite.config.mjs",
    "test:frontend": "node --test tests/*.mjs",
    "verify:manuals": "node scripts/verify-grounded-manuals.mjs --contracts-only",
    "verify:orchestration-runtime": "node scripts/verify-orchestration-runtime.mjs",
    "verify:launcher-package": "python scripts/verify_launcher_package.py --write",
    "verify:web-distribution": "python scripts/verify_public_web_distribution.py --write",
    "verify:private-nas-web": "python scripts/verify_private_nas_web_deployment.py --write",
    "verify:public-launch": "python scripts/verify_public_launch_readiness.py --write",
    "verify:self-improvement": "python scripts/verify_self_improvement_evidence.py --write",
    "verify:release-artifacts": "python scripts/archive_release_proofs.py",
    "sample:self-improvement-red-team": "python scripts/verify_self_improvement_evidence.py --record-red-team-sample",
    "advance:self-improvement-red-team": "python scripts/advance_self_improvement_red_team_loop.py",
    "verify:authenticated-phone": "python scripts/verify_authenticated_phone_progress.py",
    "verify:performance-budget": "python scripts/verify_performance_budget.py --output .agent_control/performance/latest-budget-report.json",
    "verify:sdk-bindings:ts": "tsc -p sdk/typescript/tsconfig.json",
    "web:backend": "uv run python scripts/run_web_backend.py",
    "web:serve": "npm run frontend:build && uv run python scripts/run_web_backend.py",
    "nas:setup": "python scripts/nas_setup.py",
    "nas:worker": "python scripts/run_grant_agent_cli.py worker-run --host-id nas.example.invalid --poll-seconds 10",
    "nas:worker:doctor": "python scripts/run_grant_agent_cli.py worker-doctor --host-id nas.example.invalid",
    "verify:cu": "uv run python -m grant_agent.cu_acceptance",
    "verify:browser": "node scripts/control_route_smoke.mjs",
    "verify:legacy-browser-smoke": "node scripts/control_route_smoke.mjs",
    "verify:neyvia-conversations": "python scripts/verify_neyvia_conversation_fabric.py",
    "verify:pwa": "node scripts/verify_pwa.mjs",
    "verify:control": "python scripts/verify_control_workspace.py",
    "verify:live-data": "python scripts/verify_live_data_contract.py",
    "verify:authenticated-live": "python scripts/verify_authenticated_live_control.py",
    "verify:authenticated-live-agent": "python scripts/verify_authenticated_live_agent.py",
    "verify:real-agent-conversation": "python scripts/verify_real_agent_conversation_proof.py",
    "verify:real-agent-conversation:opencode": "python scripts/verify_real_agent_conversation_proof.py --runtime opencode --fresh-runtime",
    "verify:real-agent-conversation:all-bags": "python scripts/verify_real_agent_conversation_proof.py --runtime auto --fresh-runtime --with-browser --require-all-bags",
    "verify:model-collection-launch": "python scripts/verify_model_collection_harness_launch.py",
    "verify:solantir-preview": "python scripts/verify_solantir_preview.py",
    "verify:mission-pack-launch": "python scripts/verify_mission_pack_launch.py",
    "verify:controlled-ai-safety-review": "python scripts/run_controlled_ai_safety_review.py",
    "verify:production-gate": "python scripts/verify_production_release.py --root .",
    "verify:production-gate:ci": "python scripts/verify_production_release.py --root . --ci --output .agent_control/release_artifacts/ci-production-gate.json",
    "verify:workbench-bridge": "python scripts/verify_workbench_program_bridge.py --with-browser --run-runtime-flow",
    "import:real-agent-proof": "python scripts/import_real_agent_proof_bundle.py",
    "verify:desktop": "python -m pytest tests -q && npm run frontend:build && npm run tauri build -- --debug",
    "dev": "tauri dev",
    "dev:live": "powershell -NoProfile -Command \"Get-Process vibe-coding-platform,cargo -ErrorAction SilentlyContinue | Stop-Process -Force\"; tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify:responsive": "python scripts/control_route_responsive_smoke.py",
    "verify:long-history": "python scripts/control_route_responsive_smoke.py --long-history-fixture --expect \"Side-by-side proof diff\"",
    "verify:live-detail-performance": "python scripts/control_route_responsive_smoke.py --measure-performance",
    "verify:beginner-launch": "python scripts/control_route_responsive_smoke.py --assert-launch-interactions",
    "verify:authenticated-settings": "python scripts/verify_authenticated_settings_surface.py",
    "sample:route-trust-live": "python scripts/run_route_trust_sampling_missions.py",
    "sample:route-trust-closeout": "python scripts/review_route_trust_sampling_closeouts.py",
    "sample:route-trust-loop": "python scripts/advance_route_trust_sampling_loop.py --resume-stale-waiting",
    "repair:mission-artifacts": "python scripts/plan_mission_artifact_repairs.py --write",
    "plan:nas-storage-cleanup": "python scripts/plan_nas_storage_cleanup.py",
    "sync:nas-audit": "python scripts/sync_nas_system_audit.py",
    "sync:nas-mission-detail-status": "python scripts/sync_nas_mission_detail_status.py"
  },
  "files": [
    "scripts/fluxio-cli.mjs",
    "scripts/neyvia-cli.mjs",
    "scripts/launch_fluxio.py",
    "scripts/launch_neyvia.py",
    "scripts/verify_launcher_package.py",
    "scripts/verify_public_web_distribution.py",
    "scripts/verify_private_nas_web_deployment.py",
    "scripts/verify_public_launch_readiness.py",
    "scripts/verify_self_improvement_evidence.py",
    "scripts/archive_release_proofs.py",
    "scripts/advance_self_improvement_red_team_loop.py",
    "scripts/verify_authenticated_phone_progress.py",
    "scripts/verify_authenticated_live_control.py",
    "scripts/verify_authenticated_live_agent.py",
    "scripts/verify_live_data_contract.py",
    "scripts/verify_model_collection_harness_launch.py",
    "scripts/verify_real_agent_conversation_proof.py",
    "scripts/import_real_agent_proof_bundle.py",
    "scripts/verify_solantir_preview.py",
    "scripts/verify_mission_pack_launch.py",
    "scripts/run_controlled_ai_safety_review.py",
    "scripts/verify_workbench_program_bridge.py",
    "scripts/run_web_backend.py",
    "scripts/run_grant_agent_cli.py",
    "src",
    "manuals",
    "config/neyvia_manuals.json",
    "plugins/neyvia",
    "web/dist",
    "src-tauri",
    "scripts/plan_mission_artifact_repairs.py",
    "scripts/control_route_responsive_smoke.py",
    "scripts/verify_authenticated_settings_surface.py",
    "scripts/run_route_trust_sampling_missions.py",
    "scripts/review_route_trust_sampling_closeouts.py",
    "scripts/advance_route_trust_sampling_loop.py",
    "scripts/plan_nas_storage_cleanup.py",
    "scripts/sync_nas_system_audit.py",
    "scripts/sync_nas_mission_detail_status.py",
    "web/public"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.564.0",
    "motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.10.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "vite": "^7.3.6",
    "postcss": "^8.5.18",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "uuid": "^13.0.1"
  }
}
