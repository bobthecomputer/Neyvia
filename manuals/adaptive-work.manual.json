          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "workId",
        "text"
      ],
      "allOf": [
        {
          "properties": {
            "workId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "text": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "work.problem": {
      "type": "object",
      "properties": {
        "workId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "blocker": {
          "type": "string"
        }
      },
      "required": [
        "workId",
        "text"
      ],
      "allOf": [
        {
          "properties": {
            "workId": {
              "not": {
                "enum": [
