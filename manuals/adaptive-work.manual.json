          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "workId",
        "text"
      ],
      "allOf": [
        {
          "properties": {
            "workId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "text": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "work.focus": {
      "type": "object",
      "properties": {
