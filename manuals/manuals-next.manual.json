              "expectedSha256": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "patchId": {
                "type": "string"
              },
              "reviewer": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "patchId",
              "expectedSha256",
              "reviewer",
              "evidence"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "versions",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "before"
