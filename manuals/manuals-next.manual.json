          },
          "steps": [
            {
              "action": "versions",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "before"
            },
            {
              "action": "demote",
              "args": {
                "chapter": {
                  "$input": "chapter"
                },
                "id": {
                  "$input": "id"
                },
                "procedure": {
                  "$input": "procedure"
                },
                "reason": {
                  "$input": "reason"
                }
              },
              "save": "patch"
            }
          ]
        },
        "promote-reviewed-patch": {
          "goal": "Apply one explicitly reviewed quarantined patch to this workspace with current base hash and evidence",
          "inputs": {
            "type": "object",
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
