          "pre": "approved=true, reviewer, evidence and expectedSha256=current base",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.manual.patch.apply",
          "tool": "neyvia.manual.patch.apply"
        },
        "versions": {
          "effect": "Read current hash, full lineage and demoted procedures",
          "pre": "Registered manual id",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.manual.versions",
          "tool": "neyvia.manual.versions"
        },
        "demote": {
          "effect": "Quarantine procedure removal; explicit patch.apply required",
          "pre": "Existing procedure plus reason",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.manual.demote",
          "tool": "neyvia.manual.demote"
        },
        "recovery.bind": {
          "effect": "Bind recipe to hash, exact failure, inputs and original tool restriction",
          "pre": "Observed failed runId and typed recovery procedure/inputs",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.manual.recovery.bind",
          "tool": "neyvia.manual.recovery.bind"
        },
        "recover": {
          "effect": "Run a fresh checked recovery; never replay failed effects; unchanged original failure retained",
          "pre": "Failed runId and matching recipeId; caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.manual.recover",
          "tool": "neyvia.manual.recover"
        }
      },
      "checks": {},
      "procedures": {
        "quarantine-observation": {
          "goal": "Save one observed manual frontier as a quarantined patch without changing the active version",
          "inputs": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "observed": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "note",
              "observed"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "versions",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "before"
