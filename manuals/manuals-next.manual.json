          ],
          "question": "Is the quarantined change supported by current evidence?"
        }
      },
      "pitfalls": [
        {
          "failure": "stale baseSha256 or invalid action schema",
          "recovery": "Read current version, revise quarantined patch, rerun grounding; do not bypass CAS."
        },
        {
          "failure": "unknown situation or verifier failure without a recipe",
          "recovery": "Inspect frontier evidence; an explorer/reviewer creates a quarantined patch or bound recovery."
        }
