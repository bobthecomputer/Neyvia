            {
              "action": "frontier",
              "args": {
                "id": {
                  "$input": "id"
                },
                "note": {
                  "$input": "note"
                },
                "observed": {
                  "$input": "observed"
                }
              },
              "save": "patch"
            }
          ]
        },
        "quarantine-demotion": {
          "goal": "Quarantine removal of one named obsolete procedure while keeping the current manual active",
          "inputs": {
            "type": "object",
