      "procedures": {
        "publish-and-open": {
          "goal": "Register a real output, verify its bytes, and request its preview through the shared bus",
          "inputs": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "diff",
                  "image",
                  "report",
                  "receipt"
                ]
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "requestId"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "artifact.publish",
              "args": {
                "kind": {
                  "$input": "kind"
                },
                "path": {
                  "$input": "path"
                },
                "requestId": {
                  "$input": "requestId"
                }
              },
              "check": "published-bytes",
              "save": "published"
            },
            {
              "action": "artifact.open",
              "args": {
                "id": {
                  "$result": "published.artifact.id"
                }
              },
              "save": "opened"
            }
          ]
        },
        "verify-effect-artifact-publish": {
          "goal": "Verify the actual effect through fresh owning observers",
          "inputs": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ]
          },
          "steps": [
            {
              "action": "artifact.publish",
              "args": {
                "path": {
                  "$input": "path"
                }
              },
              "save": "effect"
            }
          ]
        }
      },
      "judge": {
        "changed-output": {
          "constraints": "Never label new bytes as the old publication; never run an output as a command",
          "options": [
            "publish-new-version",
            "inspect-writer"
          ],
          "question": "A published file changed. Is the new version an intended output?"
        }
      },
      "pitfalls": [
        {
          "failure": "File changed or disappeared",
          "recovery": "Use artifact.get; inspect the writer and publish a new version only for intended new bytes"
        },
        {
          "failure": "Request id conflict",
          "recovery": "Reuse the original request only for exact retries; choose a new id for a new intended publication"
        },
        {
          "failure": "Navigation event emitted but no rendered proof",
          "recovery": "Inspect the UI event ack and actual target; negative acks mean the screen is not wired"
        }
      ],
      "frontier": [
        "Dock-to-float gesture and classic-screen migration need Claude's rendered acceptance; backend bus receipts do not prove them",
        "Publications retain path and hash, not immutable byte copies; an old version cannot open after its file changed",
        "Existing third-party producers must call artifact.publish to join the gallery; no speculative whole-disk scan"
      ],
      "guidance": [
        "HTTP: /api/ui/outputs and /api/ui/navigation; desktop: artifact_publish/list/get/open_command and app_open_command",
        "Output events: artifact.published; navigation events: app.open or pane.show. UI deduplicates bus ids and acknowledges rendered actions",
        "Source: src/grant_agent/neyvia_outputs.py and neyvia_voice.py; manual procedure makes deterministic tool calls with executable hash availability check"
      ]
    },
