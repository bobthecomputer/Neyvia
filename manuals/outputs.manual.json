                "kind": "outputs",
                "target": {
                  "$input": "target"
                }
              },
              "check": "pane-request-saved",
              "save": "requested"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [],
      "frontier": [
        "A persisted bus request does not prove the UI rendered the pane."
      ],
      "guidance": []
    },
