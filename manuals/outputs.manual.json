        "id": "outputs.parsePerceptionTarget",
        "impact": [
          "outputs frontend model consumers"
        ],
        "phase": "post"
      },
      {
        "checkedAt": [
          "web/src/neyvia/next/nxOutputsModel.js:outsideDock -> checkedProofsEModel"
        ],
        "claim": "Undocking requires crossing a known dock boundary by the requested margin",
        "id": "outputs.outsideDock",
        "impact": [
          "outputs frontend model consumers"
        ],
        "phase": "post"
      },
      {
        "checkedAt": [
          "web/src/neyvia/next/nxOutputsModel.js:dropSpot -> checkedProofsEModel"
        ],
        "claim": "Floating drops choose nearest side and a clamped vertical fraction",
        "id": "outputs.dropSpot",
        "impact": [
          "outputs frontend model consumers"
        ],
        "phase": "post"
      },
      {
        "checkedAt": [
          "web/src/neyvia/next/NxOutputs.jsx",
          "web/src/neyvia/next/NxArtifactPane.jsx",
          "web/src/neyvia/next/NxLocalOnly.jsx",
          "web/src/neyvia/next/nxSettingsApi.js",
          "scripts/p22_outputs_journey.mjs"
        ],
        "claim": "Mounted production Outputs shows a finite scratch report with available status and its Markdown content; the mounted ArtifactPane reopens the same content, and Local-only visibly refuses an external artifact URL without requesting it. Local route fixtures prove component rendering and gating only, not backend publication or retrieval.",
        "id": "outputs.rendered-scratch-artifact-journey",
        "impact": [
          "Outputs list and published-status preview",
          "ArtifactPane reopen behavior and local-only URL refusal"
        ],
        "phase": "post"
      },
      {
        "checkedAt": [
          "grant_agent.proofs_semantic_outcomes.outputs_publication",
          "grant_agent.proofs_semantic_outcomes._outputs_assert_opened",
          "grant_agent.neyvia_workspace_tools.WorkspaceTools.call",
          "grant_agent.neyvia_workspace_tools.WorkspaceTools._call_unchecked",
          "grant_agent.proof_contracts.invoke",
          "grant_agent.neyvia_outputs.publish",
          "grant_agent.neyvia_outputs.get",
          "grant_agent.neyvia_outputs.listing",
          "grant_agent.neyvia_outputs.call",
          "grant_agent.neyvia_files_tools.guard",
          "grant_agent.neyvia_workspace_tools.WorkspaceTools.safe_path",
          "grant_agent.neyvia_panes.open_artifact",
          "grant_agent.cl.renderer_effects.show"
        ],
        "claim": "The production WorkspaceTools artifact actions publish an in-scope Markdown report with independently checked exact bytes and digest, replay an exact request idempotently, and return its exact preview with a persisted pending-renderer pane request. Changed bytes make the prior get/open unavailable and conflict with reuse of its requestId; a fresh request publishes a linked recoverable version. An outside-workspace path is refused by the Files guard before publication.",
        "id": "outputs.backend-publication-byte-recovery",
        "impact": [
          "Native Outputs publication, identity, and retry behavior",
          "Changed-byte refusal and linked-version recovery",
          "Markdown preview payload and pending renderer handoff",
          "Files-scope refusal before publication"
        ],
        "phase": "post"
      }
    ]
  },
