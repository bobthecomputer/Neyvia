    "navigation": {
      "title": "Shared pane navigation",
      "state": {},
      "actions": {
        "pane.show": {
          "effect": "Persist a shared UI bus request. UI acknowledgement proves rendered opening.",
          "pre": "Selected workspace; typed target belongs to the requested pane",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.pane.show",
          "tool": "neyvia.pane.show"
        }
      },
      "checks": {
        "pane-request-saved": {
          "args": {},
          "expect": {
            "op": "eq",
            "path": "pane",
            "value": {
              "kind": "outputs",
              "target": {
                "$input": "target"
              }
            }
