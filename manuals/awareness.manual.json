          "schema": "neyvia.work.list",
          "tool": "neyvia.work.list"
        },
        "work.claim": {
          "effect": "Persist advisory claim and return overlaps; same agent/chat/path set refreshes intent, no requestId field",
          "pre": "1–100 nonblank normalized paths <400 chars; intent 1–300 chars; board capacity <=200; agent/chat identify ownership",
          "returns": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "object",
