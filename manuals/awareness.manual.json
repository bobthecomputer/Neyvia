        },
        "work.release": {
          "effect": "Remove active claim, retain newest 30 release receipts; does not revert files or stop worker",
          "pre": "ID from an active claim; already-released IDs are refused",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.work.release",
          "tool": "neyvia.work.release"
        },
        "impact": {
          "effect": "Return command/tool/UI/bridge/test/manual connections and missing wiring; no execution or repair",
          "pre": "Named repository-relative paths; static repository index available",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.impact",
          "tool": "neyvia.impact"
        },
        "intent.checklist": {
