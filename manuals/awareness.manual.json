            "required": [
              "files",
              "intent"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "work.list",
              "args": {},
              "save": "board"
            },
            {
              "action": "work.claim",
              "args": {
                "files": {
                  "$input": "files"
                },
                "intent": {
                  "$input": "intent"
                }
              },
              "save": "claimed"
            },
            {
              "action": "impact",
              "args": {
                "paths": {
                  "$input": "files"
                }
              },
              "save": "impact"
            },
            {
              "judge": "overlap"
            },
            {
              "action": "work.release",
              "args": {
                "id": {
                  "$result": "claimed.claim.id"
                }
              },
              "save": "released",
              "when": {
                "judge": "overlap",
                "option": "release"
              }
            }
          ]
        },
        "verify-effect-work-claim": {
          "goal": "Verify the actual effect through fresh owning observers",
          "inputs": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 100
              },
              "intent": {
                "type": "string"
              }
            },
            "required": [
              "files",
              "intent"
            ]
          },
          "steps": [
            {
              "action": "work.claim",
              "args": {
                "files": {
                  "$input": "files"
                },
                "intent": {
                  "$input": "intent"
                }
              },
              "save": "effect"
            }
          ]
        },
        "verify-effect-work-release": {
          "goal": "Verify the actual effect through fresh owning observers",
          "inputs": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          "steps": [
            {
              "action": "work.release",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "effect"
            }
          ]
        }
      },
      "judge": {
        "overlap": {
          "constraints": "Compare returned overlaps against exact file scope; claims are advisory and do not lock files. Coordinate conflicting ownership before proceed; released claim remains historical.",
          "options": [
            "proceed",
            "release"
          ],
          "question": "Can this claimed work proceed without conflicting with existing owners?"
        },
        "intent": {
          "constraints": "Read original text and preserve corrections; template is not a completed checklist. Resolve target/authority ambiguity before mutation; local formatting choices need no extra approval.",
          "options": [
            "ready",
            "clarify"
          ],
          "question": "Does the generated checklist schema leave a decision-changing ambiguity?"
        }
      },
      "pitfalls": [
        {
          "failure": "Claim overlaps another worker",
          "recovery": "Inspect overlap paths/intent and coordinate; board is not a lock or authorization"
        },
        {
          "failure": "Claim looks old but worker may still be running",
          "recovery": "Check owner evidence; staleness is advisory, never automatically release others"
        },
        {
          "failure": "Impact map reports handler but no UI/bridge/manual",
          "recovery": "Inspect named wiring before claiming complete; static matches do not prove runtime"
        },
        {
          "failure": "Checklist returned prompt/schema only",
          "recovery": "Have model fill schema from actual asks; do not display template as completed plan"
        }
      ],
      "frontier": [
        "Runtime-import/dynamic command wiring cannot be established from static impact matching",
        "No scheduler or conflict-enforcement mechanism on the advisory board"
      ],
      "guidance": [
        "Source: src/grant_agent/neyvia_awareness.py; src/grant_agent/neyvia_impact.py; tests/test_neyvia_awareness.py."
      ]
    },
