      "procedures": {
        "claim-and-review": {
          "goal": "Claim intended paths, inspect overlap and wiring, release immediately if ownership conflicts",
          "inputs": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 100
              },
              "intent": {
                "type": "string"
              }
