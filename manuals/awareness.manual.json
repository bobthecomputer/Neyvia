      "procedures": {
        "prepare": {
          "goal": "Prepare a lossless reading aid; refuse uncovered sentences",
          "inputs": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
