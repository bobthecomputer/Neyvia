{
  "schema": "neyvia.manual.v1",
  "id": "hyperframes",
  "kind": "environment",
  "schemas": {
    "neyvia.mod.hyperframes.edit": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        },
        "op": {
          "type": "string",
          "maxLength": 4000,
          "enum": [
            "move",
            "trim",
            "split",
            "delete",
            "set",
            "duplicate"
          ]
        },
        "ref": {
          "type": "string",
          "maxLength": 200
        },
        "time": {
          "type": "number"
        },
        "options": {
          "type": "object"
        }
      },
      "required": [
        "project",
        "op",
        "ref"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "ref": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.lint": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "project"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.render": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        },
        "out": {
          "type": "string",
          "maxLength": 4000
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "quality": {
          "type": "string",
          "maxLength": 4000,
          "enum": [
            "draft",
            "standard",
            "high"
          ]
        },
        "expectedS": {
          "type": "number"
        },
        "workers": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "project"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.snapshot": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        },
        "out": {
          "type": "string",
          "maxLength": 4000
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "frames": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "project"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.studio": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        },
        "action": {
          "type": "string",
          "maxLength": 4000,
          "enum": [
            "start",
            "stop",
            "status"
          ]
        }
      },
      "required": [
        "project",
        "action"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.timeline": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "project"
      ],
      "allOf": [
        {
          "properties": {
            "project": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.mod.hyperframes.verify": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "chapters": {
    "overview": {
      "title": "Agent-usable HyperFrames (HeyGen, Apache-2.0): lint, observe the timeline, render headless to MP4 with outcome contracts, snapshot frames and run the Studio privately.",
      "state": {},
      "actions": {
        "mod.hyperframes.lint": {
          "effect": "Lint a HyperFrames composition folder; returns the upstream findings.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.mod.hyperframes.lint",
          "tool": "neyvia.mod.hyperframes.lint"
        },
        "mod.hyperframes.timeline": {
          "effect": "Observe a composition's tracks and clips as a CL Scene.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.mod.hyperframes.timeline",
          "tool": "neyvia.mod.hyperframes.timeline"
        },
        "mod.hyperframes.render": {
          "effect": "Render a composition headless to MP4 and check duration, frame count, black/frozen frames and audio clipping on the file.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.mod.hyperframes.render",
          "tool": "neyvia.mod.hyperframes.render"
        },
        "mod.hyperframes.edit": {
          "effect": "One upstream timeline edit (move, trim, split, delete, set, duplicate) on a clip ref, then re-observe the timeline.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.mod.hyperframes.edit",
          "tool": "neyvia.mod.hyperframes.edit"
        },
        "mod.hyperframes.snapshot": {
          "effect": "Capture exact frames as PNG at given times.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.mod.hyperframes.snapshot",
          "tool": "neyvia.mod.hyperframes.snapshot"
        },
        "mod.hyperframes.studio": {
          "effect": "Start, stop or read the HyperFrames Studio preview server for a project (127.0.0.1:49165, no browser window).",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.mod.hyperframes.studio",
          "tool": "neyvia.mod.hyperframes.studio"
        },
        "mod.hyperframes.verify": {
          "effect": "Real round trip on a two-clip composition: render headless, then the outcome contracts.",
          "pre": "Selected workspace; the mod is installed, enabled and its local tool is present",
          "returns": {
            "type": "object",
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "reversible": false,
          "schema": "neyvia.mod.hyperframes.verify",
          "tool": "neyvia.mod.hyperframes.verify"
        }
      },
      "checks": {},
      "procedures": {
        "verify-hyperframes": {
          "goal": "Run the real round trip and check its outcome contracts",
          "inputs": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "mod.hyperframes.verify",
              "args": {},
              "save": "verified"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [
        {
          "failure": "The local tool is missing",
          "recovery": "Build or point the NEYVIA_* path at it; the action refuses rather than downloading anything."
        },
        {
          "failure": "A render exists but is wrong",
          "recovery": "Read the outcome block (duration, frames, black/frozen runs, clipping); never call a render good from its exit code."
        }
      ],
      "frontier": [
        "HyperFrames 0.8.138 cannot attach to an existing browser over CDP; it launches the local chrome-headless-shell with a throwaway profile. On Windows capture is screenshot mode, about 2-6 frames per second per render on a loaded machine.",
        "Adapted, not forked: every action runs the unmodified upstream program. HyperFrames by HeyGen, Apache-2.0, https://github.com/heygen-com/hyperframes."
      ],
      "guidance": [
        "Compositions are HTML: clips are elements with data-start, data-duration and data-track-index; one paused GSAP timeline is registered at window.__timelines[composition-id].",
        "Observe with mod.hyperframes.timeline, change the HTML, lint, then render; read the outcome block before calling a render good.",
        "Open the visual editor through the HyperFrames Studio app; it embeds the Studio served on loopback.",
        "Installs switched off from Marketplace > Apps & mods; read this manual and the declared permissions, then enable it."
      ]
    }
  }
}
