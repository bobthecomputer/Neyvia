L connections.overview v1 -- Every way Neyvia reaches a model, honest state and a proven one-click connect
-- @record {"chapter":"overview","data":{"effect":"Observe the real card and latest installation, sign-in and proof state.","pre":"Install, sign-in and Test it require the explicit person click. Installation also needs this exact pending approval. Observe completion separately.","returns":{"type":"object","additionalProperties":true},"reversible":false,"schema":"inspect","tool":"neyvia.connections.inspect"},"key":"inspect","section":"actions"}
A neyvia.connections.inspect(id:str force?:bool) -> json:"{\"type\":\"object\",\"additionalProperties\":true}" -- Observe the real card and latest installation, sign-in and proof state.
C neyvia.connections.inspect installed: neyvia.connections.inspect(id:id).installed==true
C neyvia.connections.inspect signed-in: neyvia.connections.inspect(id:id).state=="connected"
C neyvia.connections.inspect round-trip: neyvia.connections.inspect(id:id).proof.ok==true
