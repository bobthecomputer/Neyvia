-- @record {"chapter":"overview","data":{"effect":"Install a trusted local folder or GitHub git URL into an immutable private snapshot; no dependency installs.","pre":"Selected workspace; module is mapped and any optional dependencies are enabled","returns":{"type":"object"},"reversible":true,"schema":"neyvia.marketplace.install","tool":"neyvia.marketplace.install"},"key":"marketplace.install","section":"actions"}
