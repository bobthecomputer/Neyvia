-- @record {"chapter":"overview","data":{"effect":"Enable or disable an installed source app or mod, protecting active dependencies.","pre":"Selected workspace; module is mapped and any optional dependencies are enabled","returns":{"$cl_type":"t8"},"reversible":true,"schema":"neyvia.marketplace.set","tool":"neyvia.marketplace.set"},"key":"marketplace.set","section":"actions"}
A neyvia.marketplace.set(id:str enabled:bool) -> json:"{\"type\":\"object\"}" ! -- Enable or disable an installed source app or mod, protecting active dependencies.
C neyvia.marketplace.set enabled-state:neyvia.modules.get(id:id) .module.enabled == enabled
C neyvia.marketplace.set enable-source:neyvia.marketplace.get(id:id) .item.state == "active"
C neyvia.marketplace.set disable-source:neyvia.marketplace.get(id:id) .item.state == "disabled"
