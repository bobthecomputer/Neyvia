-- @record {"chapter":"deadline-driver","data":"Fresh Chrome, Edge and VS Code profiles may expose a task-reserved CDP endpoint on an explicit owned port. The DOM route verifies the local document URL or the token-bearing VS Code page before every evaluation, changes real fields, dispatches their application events and reads fresh values. It never attaches to a user's profile or sends desktop input.","key":"8","section":"guidance"}
