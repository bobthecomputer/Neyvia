-- @record {"chapter":"deadline-driver","data":"Create a fresh task-local target whose path contains a random 32-character hexadecimal token. launch_app args may include disposable_target {path,token}; the driver binds it only after independent new-window job/desktop ownership and an observed token in its title. Existing broker windows cannot be adopted by this argument.","key":"7","section":"guidance"}
