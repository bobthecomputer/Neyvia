-- @record {"chapter":"deadline-driver","data":"scripts/prove_c11f_shell.py performs actual CREATE_NO_WINDOW file tasks with independent file and ZIP readback. It cannot change system configuration. C11f.json records these lanes separately from the native manual-compiler cohort.","key":"14","section":"guidance"}
