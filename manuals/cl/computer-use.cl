L computer-use.deadline-driver v1 -- C1b: bounded native observation and verified delivery
-- @record {"chapter":"deadline-driver","data":{"args":{"sessionId":{"$input":"sessionId"},"window_id":{"$input":"window_id"}},"inputs":{"$cl_type":"t13"},"shape":{"$cl_type":"t14"},"tool":"neyvia.cua.inspect"},"key":"window","section":"state"}
