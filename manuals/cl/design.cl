-- @record {"chapter":"learned-capabilities","data":{"goal":"Find a learned pattern, compose a new draft, reject focus loss and keep personal taste separate","inputs":{"$cl_type":"t6"},"steps":[{"action":"find","args":{"intent":"search choices keyboard input"},"check":"find-is-advisory","save":"observed0"},{"action":"invent","args":{"intent":"search preview compare alternatives"},"check":"draft-needs-review","save":"observed1"},{"action":"feel","args":{"code":"button { outline: none; }"},"check":"focus-loss-requires-repair","save":"observed2"},{"action":"feel","args":{"intent":"plain writing motion"},"check":"personal-stays-separate","save":"observed3"},{"action":"feel","args":{"render":{"overflow":true}},"check":"boolean-overflow","save":"observed4"},{"action":"feel","args":{"code":"main {max-width:1060px}"},"check":"max-width-is-responsive","save":"observed5"}]},"key":"prove-component-advice","section":"procedures"}
