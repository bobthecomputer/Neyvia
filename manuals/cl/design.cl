-- @record {"chapter":"overview","data":{"constraints":"Extend only when no token/primitive fits and three places need it. A new colour token is defined in all four theme blocks (.nx default=Forest, light, sunset, night) and named for its meaning, not its hue.","options":["reuse","extend"],"question":"Do existing tokens and primitives cover this change?"},"key":"reuse-or-extend","section":"judge"}
