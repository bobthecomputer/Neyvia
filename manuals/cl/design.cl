-- @record {"chapter":"check-loop","data":{"goal":"Render a page in light and dark at desktop and phone width, refuse blocked or blank renders, look, and show the proof","inputs":{"$cl_type":"t25"},"steps":[{"action":"taste","args":{"colorScheme":"light","url":{"$input":"url"},"viewports":["desktop","phone"],"waitFor":{"$input":"waitFor"}},"check":"light-rendered","save":"light"},{"action":"taste","args":{"colorScheme":"dark","url":{"$input":"url"},"viewports":["desktop","phone"],"waitFor":{"$input":"waitFor"}},"check":"dark-rendered","save":"dark"},{"judge":"visual"},{"action":"pane.show","args":{"kind":"artifact","target":{"$result":"light.screenshots.desktop.path"}},"save":"shown","when":{"judge":"visual","option":"ship"}}]},"key":"check-render","section":"procedures"}
P check-render(url:str waitFor:str):light=preview.taste(colorScheme:"light" url:url viewports:["desktop" "phone"] waitFor:waitFor) C light-rendered; dark=preview.taste(colorScheme:"dark" url:url viewports:["desktop" "phone"] waitFor:waitFor) C dark-rendered; J visual=ship; shown=neyvia.pane.show(kind:"artifact" target:light.screenshots.desktop.path) -- Render a page in light and dark at desktop and phone width, refuse blocked or blank renders, look, and show the proof
V P check-render -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"check-loop","data":{"goal":"Verify a component's CSS and JSX against the token, motion, layout, focus and copy rules, then render its design-lab specimen in light and dark","inputs":{"$cl_type":"t26"},"steps":[{"action":"read","args":{"path":{"$input":"cssPath"}},"check":"component-css","save":"css"},{"action":"read","args":{"path":{"$input":"jsxPath"}},"check":"component-jsx","save":"jsx"},{"action":"taste","args":{"colorScheme":"light","url":{"$input":"url"},"viewports":["desktop","phone"],"waitFor":{"$input":"waitFor"}},"check":"light-rendered","save":"light"},{"action":"taste","args":{"colorScheme":"dark","url":{"$input":"url"},"viewports":["desktop","phone"],"waitFor":{"$input":"waitFor"}},"check":"dark-rendered","save":"dark"},{"judge":"visual"}]},"key":"check-component","section":"procedures"}
P check-component(cssPath:str jsxPath:str url:str waitFor:str):css=workspace.read(path:cssPath) C component-css; jsx=workspace.read(path:jsxPath) C component-jsx; light=preview.taste(colorScheme:"light" url:url viewports:["desktop" "phone"] waitFor:waitFor) C light-rendered; dark=preview.taste(colorScheme:"dark" url:url viewports:["desktop" "phone"] waitFor:waitFor) C dark-rendered; J visual -- Verify a component's CSS and JSX against the token, motion, layout, focus and copy rules, then render its design-lab specimen in light and dark
V P check-component -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"check-loop","data":{"goal":"Build the actual configured candidate source into a fresh owned output, wait for completion, and read the build log and emitted entrypoint.","inputs":{"$cl_type":"t27"},"steps":[{"action":"build","args":{"command":"import runpy; runpy.run_path('scripts/c8e_design_checks.py')['run']('build', '.')","shell":"python","timeoutMs":120000},"save":"started"},{"judge":"build-wait"},{"action":"read","args":{"path":".agent_control/build-check.log"},"check":"build-passed","save":"log","when":{"judge":"build-wait","option":"finished"}},{"action":"read","args":{"path":".agent_control/build-check/index.html"},"check":"build-entrypoint","save":"entrypoint"}]},"key":"build-check","section":"procedures"}
P build-check():started=terminal.exec(command:"import runpy; runpy.run_path('scripts/c8e_design_checks.py')['run']('build', '.')" shell:"python" timeoutMs:120000); J build-wait=finished; log=workspace.read(path:".agent_control/build-check.log") C build-passed; entrypoint=workspace.read(path:".agent_control/build-check/index.html") C build-entrypoint -- Build the actual configured candidate source into a fresh owned output, wait for completion, and read the build log and emitted entrypoint.
V P build-check -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"check-loop","data":{"constraints":"Open every PNG. Name where the eye lands first and what competes; check Morning contrast, phone wraps, doubled borders. Any block finding or overflow is revise. A clear gate with nothing visible is a blank render, not a pass.","evidence":["screenshot"],"kind":"model","options":["ship","revise"],"question":"Looking at the screenshots, is it calm, clear and right in both themes and at phone width?"},"key":"visual","section":"judge"}
J visual ship|revise:"Looking at the screenshots, is it calm, clear and right in both themes and at phone width?" -- Open every PNG. Name where the eye lands first and what competes; check Morning contrast, phone wraps, doubled borders. Any block finding or overflow is revise. A clear gate with nothing visible is a blank render, not a pass.
V J visual -> model:large evidence:screenshot why:"model judgment bound to current evidence"
