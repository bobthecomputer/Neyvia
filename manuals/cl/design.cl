-- @record {"chapter":"copy","data":"A confirm repeats the consequence ('Delete project?' offers 'Delete project' and 'Cancel'); a toggle names its ON state ('Send read receipts', never a negative); an action keeps its name through a flow ('Publish' then 'Published') (after Jakub Krehel's better-writing and Anthropic's frontend-design).","key":"8","section":"guidance"}
