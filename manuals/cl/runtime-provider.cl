-- @proof {"checkedAt":["grant_agent.runtime_handback.handback_messages","grant_agent.proofs_d_runtime.check"],"claim":"Handed-back transcript messages retain content/text and origin; user/operator messages are authored by You, other messages by their originating runtime.","id":"d.runtime.handback.transcript","impact":["parent transcript authorship"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.runtime_wrapper.build_runtime_wrapper_spec","grant_agent.runtime_wrapper.runtime_wrapper_payload","grant_agent.proofs_d_runtime.check"],"claim":"Only supported wrappers with nonempty commands produce specs; exact command, cwd, timeout and sorted environment key names survive without serializing environment values.","id":"d.runtime.wrapper.spec","impact":["external runtime wrapper launch plans"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.runtime_wrapper.build_runtime_wrapper_state","grant_agent.proofs_d_runtime.check"],"claim":"Wrapper observations retain their runtime/cwd, observed processes, masked environment status, positive TTL and nonnegative heartbeat age; actual file tails stay bounded.","id":"d.runtime.wrapper.state","impact":["runtime observation","bounded logs"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.runtime_wrapper.build_runtime_wrapper_phase_event","grant_agent.proofs_d_runtime.check"],"claim":"Phase events retain the wrapper's runtime/cwd/log path and the supplied mission/run/phase/status/message association.","id":"d.runtime.wrapper.event","impact":["mission phase event provenance"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.runtime_wrapper.build_runtime_wrapper_execution_receipt","grant_agent.proofs_d_runtime.check"],"claim":"Execution receipts project the exact wrapper command, changed files, bounded observed logs, process tree, masked environment, heartbeat age and TTL.","id":"d.runtime.wrapper.receipt","impact":["runtime execution receipts"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.runtime_wrapper.replay_runtime_wrapper","grant_agent.proofs_d_runtime.check"],"claim":"File-backed replay admits only real dictionary rows, skips missing/malformed inputs, respects the event bound and derives latest status from observed receipt/event rows.","id":"d.runtime.wrapper.replay","impact":["runtime replay","honest completion status"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.profiles.ProfileRegistry.resolve","grant_agent.proofs_d_runtime.check"],"claim":"Profile selection resolves an explicit existing name first, first matching workspace rule second and registered default last, preserving the selected profile's agent policy.","id":"d.runtime.profile.resolve","impact":["personalization","agent risk policy"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.openai_adapter.tools_from_skills","grant_agent.proofs_d_runtime.check"],"claim":"Skill tools retain name, description, schema and strictness; enabled code execution retains auto memory/file configuration or selected container identity.","id":"d.runtime.openai.tools","impact":["OpenAI request tool schemas"],"phase":"invariant"}
