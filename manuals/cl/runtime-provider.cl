-- @proof {"checkedAt":["scripts/repair_nas_opencode_go_auth.py:_redact","grant_agent.proofs_d_runtime.self_check"],"claim":"The pure receipt redactor removes the supplied secret and returns at most 8000 characters; proof fixtures use in-memory scratch strings only.","id":"d.runtime.go-env.redact","impact":["repair receipt secrecy"],"phase":"invariant"}
