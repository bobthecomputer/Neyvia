-- @proof {"checkedAt":["grant_agent.p2p_cache.P2PCacheService.plan_import","grant_agent.p2p_cache.P2PCacheService._workspace_file","grant_agent.proofs_d_runtime.check"],"claim":"Import plans are workspace-scoped, BLAKE3/hash bound, preserve current source metadata and kind/pin intent, and state that local import needs no network or publication.","id":"d.runtime.cache.plan","impact":["local CAS import approval"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.p2p_cache.P2PCacheService.import_object","grant_agent.proofs_d_runtime.check"],"claim":"An unapproved local import performs no admission; approved receipts retain plan/content/source identity and pin/kind, honestly distinguish copy from deduplication and claim only locally verified bytes. Source or plan drift fails closed.","id":"d.runtime.cache.import","impact":["local CAS integrity and approval"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.p2p_cache.P2PCacheService.read_text","grant_agent.p2p_cache.P2PCacheService._verified_object","grant_agent.proofs_d_runtime.check"],"claim":"Local context reads are bounded, retain digest/offset and match actual admitted bytes and truncation; invalid hash/range or changed admitted content fails closed before context is returned.","id":"d.runtime.cache.read","impact":["model context integrity"],"phase":"invariant"}
