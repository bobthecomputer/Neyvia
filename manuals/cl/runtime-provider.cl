-- @proof {"checkedAt":["grant_agent.runtime_lane_cycle.normalize_lane_routes","grant_agent.proofs_d_runtime.check"],"claim":"The four required context/planner/executor/verifier lanes keep their role order and the selected runtime alias normalizes to the owning runtime without launch or route substitution.","id":"d.runtime.lane.aliases","impact":["runtime lane route plans"],"phase":"invariant"}
