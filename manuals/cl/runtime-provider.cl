-- @proof {"checkedAt":["grant_agent.platform_config.PlatformConfig.from_env","grant_agent.proofs_d_runtime.check"],"claim":"Explicit workspace and configured environment roots, project name and Windows mirror survive PlatformConfig construction; this projection performs no NAS activity.","id":"d.runtime.platform.roots","impact":["platform path correspondence"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.platform_config.PlatformConfig.path_candidates","grant_agent.proofs_d_runtime.check"],"claim":"Path candidates are unique; a configured remote project path includes its corresponding local workspace and configured mirror path.","id":"d.runtime.platform.candidates","impact":["portable saved paths"],"phase":"invariant"}
