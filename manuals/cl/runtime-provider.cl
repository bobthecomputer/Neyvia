-- @proof {"checkedAt":["grant_agent.provider_auth_queue.ProviderAuthQueue._save","grant_agent.proofs_d_runtime_auth.check_queue_save"],"claim":"Successful queue writes reread the exact payload through the existing anchored provider-state directory; no credential file is part of this proof.","id":"d.runtime.auth-queue.persisted","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.provider_auth_queue.ProviderAuthQueue._mutation","grant_agent.proofs_d_runtime_auth.check_queue_transition"],"claim":"Queue mutations preserve durable queue/provider operation identities, settle supplied presence observations, expose lost evidence as blocked, and keep cancelled/skipped operations terminal.","id":"d.runtime.auth-queue.transition","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.provider_auth_queue.ProviderAuthQueue.record_flow","grant_agent.proofs_d_runtime_auth.check_queue_transition"],"claim":"Only public flow receipt fields persist; sessionless observers preserve the owning session and conflicting sessions cannot overwrite its durable evidence.","id":"d.runtime.auth-queue.flow","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.provider_auth_queue.ProviderAuthQueue._present","grant_agent.proofs_d_runtime_auth.check_queue_present"],"claim":"Public queue views retain lifecycle and policy, hide opaque startup ownership, declare no stored secret material and keep Anthropic on its official provider route.","id":"d.runtime.auth-queue.projection","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.provider_auth_queue.ProviderAuthQueue._mutation","grant_agent.provider_auth_queue.ProviderAuthQueue._present","grant_agent.proofs_d_runtime_auth.check_queue_payload","grant_agent.proofs_d_runtime_auth.check_queue_transition","grant_agent.proofs_d_runtime_auth.check_queue_present"],"claim":"Existing workspace locks and canonical bounded durable leases reserve one startup owner; waiting pollers receive no executable action, stale owners cannot publish, and completion leaves the next startup unclaimed until a real poller.","id":"d.runtime.auth-queue.startup","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.cluster.ClusterRegistry._provider_circuit_admission_db","grant_agent.proofs_d_runtime_auth.circuit_admission"],"claim":"Inside the existing SQLite lease transaction, closed routes admit work, open cooldowns deny, and half-open routes reserve exactly one live canary keyed by host/runtime/provider. Direct lease creation rechecks the same admission rule.","id":"d.runtime.circuit.admission","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.cluster.ClusterRegistry.record_provider_result","grant_agent.proofs_d_runtime_auth.check_circuit_result"],"claim":"Observed result metadata opens only its route, respects transient thresholds and preserves stronger auth/credit cooldown against late results; successful owned canaries close/reset and failed/inconclusive canaries reopen durably.","id":"d.runtime.circuit.transition","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.cluster.classify_provider_result","grant_agent.proofs_d_runtime_auth.check_classification"],"claim":"Provider result classification keeps route identity and only bounded category evidence, separates auth/credit/rate/overload/transport, and explicit process success wins over authentication words in output.","id":"d.runtime.circuit.classification","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.cluster.ClusterRegistry.reset_provider_circuit","grant_agent.proofs_d_runtime_auth.check_circuit_reset"],"claim":"Manual circuit reset redacts bounded actor/reason evidence and asks for one future half-open canary rather than bypassing observed failure.","id":"d.runtime.circuit.reset","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.cluster.ClusterRegistry.record_provider_result","grant_agent.proofs_d_runtime_auth.check_circuit_reporting"],"claim":"Provider result publication requires the current active lease, matching job and reporting host; mismatched reporting does not update a provider circuit.","id":"d.runtime.circuit.reporting","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.worker.run_local_worker_once","grant_agent.worker.build_worker_doctor","grant_agent.proofs_d_runtime_auth.check_worker_circuit_before_completion","grant_agent.proofs_d_runtime_auth.check_worker_doctor","grant_agent.proofs_d_runtime_auth.observed_worker_capabilities"],"claim":"Workers record provider failure before durable job completion and doctor exposes every open/half-open route. Explicit trusted local capability observations/environment keep scratch runs within their owned root; they do not prove provider authentication or permit external workspace mappings.","id":"d.runtime.circuit.worker","impact":["durable local provider coordination","provider authority and scheduling"],"phase":"invariant"}
