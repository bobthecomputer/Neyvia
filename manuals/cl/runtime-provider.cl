-- @proof {"checkedAt":["scripts/setup_nas_https.py:split_hosts","grant_agent.proofs_d_runtime.self_check"],"claim":"Normalized host identities are unique and partition exactly into DNS names and valid IP addresses; a trailing DNS dot does not duplicate a host.","id":"d.runtime.nas-setup.hosts","impact":["TLS host argument planning"],"phase":"invariant"}
-- @proof {"checkedAt":["scripts/setup_nas_https.py:backend_start_command","grant_agent.proofs_d_runtime.self_check"],"claim":"The TLS backend command plan retains its explicit port, public URL and certificate/key paths; verification never launches that command or reads those files.","id":"d.runtime.nas-setup.tls-command","impact":["TLS backend command plans"],"phase":"invariant"}
-- @proof {"checkedAt":["scripts/install_nas_runtime_stack.py:node_platform_arch","scripts/install_nas_runtime_stack.py:node_dist_url","grant_agent.proofs_d_runtime.self_check"],"claim":"Supported CPU names resolve to packaged Node architecture and the planned HTTPS archive URL preserves version/architecture; unsupported CPU or empty version stops before download.","id":"d.runtime.nas-setup.node-plan","impact":["packaged runtime install plans"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_bridge.NasBridge._copy_resumable","grant_agent.proofs_d_runtime.check"],"claim":"Bridge copy completion matches actual destination SHA-256 and source size; deduplication reuses all bytes and partial resume transfers exactly the remainder.","id":"d.runtime.bridge.bytes","impact":["attachment byte integrity","local protocol resume"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_bridge.NasBridge.send_message","grant_agent.proofs_d_runtime.check"],"claim":"Each sent message's inbox/outbox envelopes exactly match its returned message and attachment metadata; transfer/reuse totals derive only from attachment receipts.","id":"d.runtime.bridge.envelope","impact":["message/attachment envelopes"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_bridge.NasBridge.receive_messages","grant_agent.proofs_d_runtime.check"],"claim":"Received materialized attachments stay under the selected output root, match actual SHA-256 and retain file names; optional acknowledgements retain message identity and inbox count stays bounded.","id":"d.runtime.bridge.receive","impact":["verified local receive","message acknowledgements"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_transfer._copy_file_resumable","grant_agent.proofs_d_runtime.check"],"claim":"Completed file copies match destination size and SHA-256, preserve exact remaining-byte resume accounting; unchanged-metadata skips do no transfer/hash work.","id":"d.runtime.transfer.file","impact":["file transfer integrity","resume and metadata skip"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_transfer._copy_directory","grant_agent.proofs_d_runtime.check"],"claim":"Directory transfer receipts account for filtered/changed/skipped files and hash-check every actually transferred destination; explicit include-all is retained and unchanged metadata does not fabricate verification work.","id":"d.runtime.transfer.directory","impact":["directory filtering and collision preservation"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.nas_transfer.NasTransfer._write_receipt","grant_agent.nas_transfer.NasTransfer.send","grant_agent.nas_transfer.NasTransfer.send_manifest","grant_agent.proofs_d_runtime.check"],"claim":"A completed transfer returns the identical JSON receipt durably persisted at its selected sender and mirror protocol roots; destination escape, unavailable explicit root and invalid batch sources stop before successful receipt/copy.","id":"d.runtime.transfer.receipt","impact":["recoverable transfer receipts","destination/preflight boundaries"],"phase":"invariant"}
