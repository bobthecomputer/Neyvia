-- @record {"chapter":"learned-capabilities","data":{"goal":"Write a real label and correction; next answer changes durably, conflicts abstain and forgetting removes its effect","inputs":{"$cl_type":"t20"},"steps":[{"action":"laya_learn","args":{"domain":"cl-instant","input":"next answer","label":false,"source":"cl-write-effect"},"check":"instant-first","save":"first"},{"action":"laya_learn","args":{"domain":"cl-instant","input":"next answer","label":true,"source":"cl-write-effect"},"check":"instant-second","save":"second"},{"action":"laya_forget","args":{"source":"cl-write-effect"},"check":"instant-forgotten","save":"forgotten"},{"action":"laya_selfcheck","args":{"part":"instant"},"check":"instant-effects","save":"instant"}]},"key":"prove-instant-learning","section":"procedures"}
