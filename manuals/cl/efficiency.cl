-- @record {"chapter":"laya","data":{"goal":"Prove LAYA's gate, receipts, hosting, routing, UI models, live-preview marker and verify call with observed facts","inputs":{"$cl_type":"t15"},"steps":[{"action":"selfcheck","args":{"part":"gate"},"check":"gate-holds","save":"observed_gate"},{"action":"selfcheck","args":{"part":"route"},"check":"routing-holds","save":"observed_route"},{"action":"selfcheck","args":{"part":"ledger"},"check":"receipts-hold","save":"observed_ledger"},{"action":"selfcheck","args":{"part":"host"},"check":"hosting-holds","save":"observed_host"},{"action":"selfcheck","args":{"part":"ui"},"check":"ui-models-hold","save":"observed_ui"},{"action":"selfcheck","args":{"part":"preview"},"check":"preview-marker-holds","save":"observed_preview"},{"action":"verify","args":{"candidate":true,"evidence":{},"question":"page_done"},"check":"verify-shape","save":"verdict"},{"action":"status","args":{},"save":"laya"}]},"key":"prove-laya","section":"procedures"}
P prove-laya():observed_gate=neyvia.efficiency.laya_selfcheck(part:"gate") C gate-holds; observed_route=neyvia.efficiency.laya_selfcheck(part:"route") C routing-holds; observed_ledger=neyvia.efficiency.laya_selfcheck(part:"ledger") C receipts-hold; observed_host=neyvia.efficiency.laya_selfcheck(part:"host") C hosting-holds; observed_ui=neyvia.efficiency.laya_selfcheck(part:"ui") C ui-models-hold; observed_preview=neyvia.efficiency.laya_selfcheck(part:"preview") C preview-marker-holds; verdict=neyvia.efficiency.laya_verify(candidate:true evidence:{} question:"page_done") C verify-shape; laya=neyvia.efficiency.laya_status() -- Prove LAYA's gate, receipts, hosting, routing, UI models, live-preview marker and verify call with observed facts
V P prove-laya -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"laya","data":{"goal":"Ask LAYA to confirm a low-confidence answer before spending a big-model check","inputs":{"$cl_type":"t18"},"steps":[{"action":"verify","args":{"evidence":{"$input":"evidence"},"question":{"$input":"question"}},"save":"verdict"}]},"key":"verify-with-laya","section":"procedures"}
P verify-with-laya(question:json:"{\"type\":\"string\",\"enum\":[\"taste_triage\",\"page_done\",\"cl_route\",\"repair_retention\"]}" evidence:json:"{\"type\":\"object\"}"):verdict=neyvia.efficiency.laya_verify(evidence:evidence question:question) -- Ask LAYA to confirm a low-confidence answer before spending a big-model check
V P verify-with-laya -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"laya","data":{"goal":"Prove request abstention and honest UI status while instant encoders warm, without loading encoders or starting a service","inputs":{"$cl_type":"t15"},"steps":[{"action":"selfcheck","args":{"part":"ui"},"check":"ui-models-hold","save":"observed_ui"},{"action":"selfcheck","args":{"part":"ui"},"check":"warmup-holds","save":"observed_warmup"}]},"key":"prove-warmup","section":"procedures"}
P prove-warmup():observed_ui=neyvia.efficiency.laya_selfcheck(part:"ui") C ui-models-hold; observed_warmup=neyvia.efficiency.laya_selfcheck(part:"ui") C warmup-holds -- Prove request abstention and honest UI status while instant encoders warm, without loading encoders or starting a service
V P prove-warmup -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"laya","data":{"failure":"LAYA is unavailable, below the 0.95 gate or its answers conflict","recovery":"verify returns escalate true; run the big-model check as before and never treat silence as agreement"},"key":"0","section":"pitfalls"}
X LAYA is unavailable, below the 0.95 gate or its answers conflict -> verify returns escalate true; run the big-model check as before and never treat silence as agreement
-- @record {"chapter":"laya","data":{"failure":"A cheap check is treated as authority for an irreversible step","recovery":"LAYA is advisory; the executable observer checks still decide"},"key":"1","section":"pitfalls"}
X A cheap check is treated as authority for an irreversible step -> LAYA is advisory; the executable observer checks still decide
