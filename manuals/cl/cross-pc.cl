-- @record {"chapter":"overview","data":{"constraints":"Use device ID, not hostname. list is cached and online can be stale; refresh shares via files.list. Pair/revoke/share/discover and transfer controls belong to owner UI. Do not probe other services or reconfigure tailnet.","options":["read","stop"],"question":"Is this the intended paired and reachable PC with the required share?"},"key":"remote-identity","section":"judge"}
