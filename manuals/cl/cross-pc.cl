-- @proof {"checkedAt":["grant_agent.web_auth_sessions.WebAuthSessions.issue","grant_agent.proofs_e_wz.check_session_issued","grant_agent.proofs_e_wz.self_check"],"claim":"Issuance stores a 64-character token digest, exactly the requested normalized account identity/name/role and bounded device metadata, the selected creation/expiry times and every prior live session unchanged inside the SQLite write transaction; bearer tokens never become SQL values.","id":"proofs-e-wz.auth-issuance","impact":["web login","parallel browser sign-in","session database"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_auth_sessions.WebAuthSessions.lookup","grant_agent.proofs_e_wz.check_session_lookup","grant_agent.proofs_e_wz.self_check"],"claim":"Accepted lookup preserves account fields and creation time, upgrades an accepted legacy identity when needed, renews expiration only past the daily renewal threshold, and persists last-use updates atomically.","id":"proofs-e-wz.auth-renewal","impact":["long-lived web login","session expiry"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_auth_sessions.WebAuthSessions.lookup","grant_agent.proofs_e_wz.check_session_rejected","grant_agent.proofs_e_wz.self_check","grant_agent.web_auth_sessions.WebAuthSessions.revoke"],"claim":"Expired, invalid-account and invalid-role sessions are removed before lookup returns no user; explicit logout removes the token digest.","id":"proofs-e-wz.auth-rejection","impact":["password changes","idle expiry","logout"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_backend_serving.HttpServingMixin.serve_artifact","grant_agent.proofs_e_wz.check_artifact_access","grant_agent.proofs_e_wz.self_check","grant_agent.web_backend.FluxioWebBackend.web_auth_sessions","grant_agent.web_backend.FluxioWebBackend.authenticated_session"],"claim":"Private artifact file bytes are served only with a currently authenticated session; cookie validation reads the durable per-account fingerprint so backend recreation preserves valid sessions and password changes/logout revoke access.","id":"proofs-e-wz.auth-artifact","impact":["private media","preview iframe","backend recreation"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_backend._json_response","grant_agent.proofs_e_wz.check_json_response","grant_agent.proofs_e_wz.self_check"],"claim":"JSON wire bytes remain compact and exact through compression; gzip is used only for accepted encodings above the existing minimum response size.","id":"proofs-e-wz.http-json","impact":["browser transport","large chat responses"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_backend._read_json_body","grant_agent.proofs_e_wz.check_request_body","grant_agent.proofs_e_wz.self_check"],"claim":"Gzip request decoding never exceeds the configured maximum decompressed JSON bytes; over-limit inputs reject before dispatch.","id":"proofs-e-wz.http-request","impact":["phone transcript upload","bounded allocation"],"phase":"pre"}
-- @proof {"checkedAt":["grant_agent.web_backend._extend_io_timeout","grant_agent.proofs_e_wz.check_io_timeout","grant_agent.proofs_e_wz.self_check"],"claim":"After a request starts, its socket uses the longer request IO timeout rather than the accept-time handshake timeout, allowing a paused reader to receive the full response.","id":"proofs-e-wz.http-io-timeout","impact":["slow phone readers","large transfers"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_backend_serving.HttpServingMixin.serve_file","grant_agent.proofs_e_wz.check_static_response","grant_agent.proofs_e_wz.self_check"],"claim":"Static files remain jailed in the selected build root and return exact file bytes; only approved desktop origins receive CORS for non-page assets. Entry pages/service workers stay uncached and embedded pages retain their supported framing policy.","id":"proofs-e-wz.desktop-shell","impact":["desktop loader","current build assets","browser security headers"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.web_backend_serving.HttpServingMixin.serve_desktop_update","grant_agent.proofs_e_wz.check_update_response","grant_agent.proofs_e_wz.self_check"],"claim":"Successful desktop update responses are allowlisted files strictly inside the update folder and contain the exact selected file bytes; unknown or escaping names cannot select a file.","id":"proofs-e-wz.desktop-update","impact":["public signed update feed","path confinement"],"phase":"post"}
