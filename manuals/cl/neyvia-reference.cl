-- @record {"chapter":"time","data":{"goal":"Start a distinct elapsed-work measurement and verify running state","inputs":{"$cl_type":"t29"},"steps":[{"action":"timer.start","args":{"id":{"$input":"id"},"label":{"$input":"label"}},"check":"timer-running","save":"started"}]},"key":"start-timer","section":"procedures"}
P start-timer(id:str label:str):started=neyvia.timer.start(id:id label:label) C timer-running -- Start a distinct elapsed-work measurement and verify running state
V P start-timer -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"time","data":{"goal":"Read elapsed timer, decide checkpoint, then record one lap and stop","inputs":{"$cl_type":"t30"},"steps":[{"action":"timer.read","args":{"id":{"$input":"id"}},"save":"before"},{"judge":"checkpoint"},{"action":"timer.lap","args":{"id":{"$input":"id"},"label":{"$input":"label"},"lapId":{"$input":"lapId"}},"save":"lap","when":{"judge":"checkpoint","option":"lap-stop"}},{"action":"timer.stop","args":{"id":{"$input":"id"}},"check":"timer-stopped","save":"stopped","when":{"judge":"checkpoint","option":"lap-stop"}}]},"key":"lap-and-stop","section":"procedures"}
P lap-and-stop(id:str lapId:str label:str):before=neyvia.timer.read(id:id); J checkpoint=lap-stop; lap=neyvia.timer.lap(id:id label:label lapId:lapId); stopped=neyvia.timer.stop(id:id) C timer-stopped -- Read elapsed timer, decide checkpoint, then record one lap and stop
V P lap-and-stop -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"time","data":{"constraints":"Timer is elapsed time, not CPU/provider cost. Stop only measurement; it does not cancel work. A stopped ID cannot be reused for a new timing intent.","options":["lap-stop","keep-running"],"question":"Record this completed checkpoint and stop measurement?"},"key":"checkpoint","section":"judge"}
J checkpoint lap-stop|keep-running:"Record this completed checkpoint and stop measurement?" -- Timer is elapsed time, not CPU/provider cost. Stop only measurement; it does not cancel work. A stopped ID cannot be reused for a new timing intent.
V J checkpoint -> human:operator why:"explicit choice required"
-- @record {"chapter":"time","data":{"failure":"Timer ID/lapId reused with different intent","recovery":"Use new ID for new measurement; exact retries replay retained values"},"key":"0","section":"pitfalls"}
X Timer ID/lapId reused with different intent -> Use new ID for new measurement; exact retries replay retained values
