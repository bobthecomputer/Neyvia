L documents.overview v1 -- Study documents: Paul's six-block template, Tectonic build, outcome checks and page renders
-- @record {"chapter":"overview","data":{"args":{"path":{"$input":"path"}},"inputs":{"$cl_type":"t2"},"shape":{"$cl_type":"t6"},"tool":"neyvia.documents.check"},"key":"document","section":"state"}
S documents.document:{ok:bool passed:int total:int ..}=neyvia.documents.check(path:path)
-- @record {"chapter":"overview","data":{"effect":"Create a study document on Paul's neyvia-study template: course (six blocks per concept) or sheet (formula, method, reflex); one chapter per title.","pre":"A workspace path for a new .tex file; overwrite only when asked","returns":{"type":"object"},"reversible":true,"schema":"neyvia.documents.create","tool":"neyvia.documents.create"},"key":"documents.create","section":"actions"}
A neyvia.documents.create(path:str#1.. variant:json:"{\"type\":\"string\",\"enum\":[\"course\",\"sheet\"]}" title:str#1.. chapters:[str#1..]#1..40 subtitle?:str#1.. sourcePrefix?:str overwrite?:bool) -> json:"{\"type\":\"object\"}" ! -- Create a study document on Paul's neyvia-study template: course (six blocks per concept) or sheet (formula, method, reflex); one chapter per title.
F verify-documents-create "No authored observer check is bound to neyvia.documents.create" -> ask operator blocks:neyvia.documents.create
-- @record {"chapter":"overview","data":{"effect":"Compile a study document with Tectonic (XeTeX, Inter bundled); returns the PDF, log, seconds and page count.","pre":"An existing .tex on the neyvia-study class; Tectonic installed (study_docs.py setup)","returns":{"type":"object"},"reversible":true,"schema":"neyvia.documents.build","tool":"neyvia.documents.build"},"key":"documents.build","section":"actions"}
A neyvia.documents.build(path:str#1..) -> json:"{\"type\":\"object\"}" ! -- Compile a study document with Tectonic (XeTeX, Inter bundled); returns the PDF, log, seconds and page count.
C neyvia.documents.build compiles: neyvia.documents.check(path:path).compiles==true
-- @record {"chapter":"overview","data":{"effect":"Run the outcome checks on a built study document: compiles, references, overfull boxes, Inter embedded, block order and source tags, page count.","pre":"The document was built by documents.build","returns":{"type":"object"},"reversible":true,"schema":"neyvia.documents.check","tool":"neyvia.documents.check"},"key":"documents.check","section":"actions"}
