-- @proof {"checkedAt":["grant_agent.ui_tools.UiToolSurface._compact_result -> grant_agent.proofs_e_sv.check","grant_agent.proofs_e_sv.self_check"],"claim":"Every compact UI result explicitly omits trees and binds its revision, semantic hash and node count to the resident graph.","id":"sv.ui.compact-result","impact":["perception","PROOFS-e s-v behavior"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.ui_tools.UiToolSurface.ui_do -> grant_agent.proofs_e_sv.check","grant_agent.proofs_e_sv.self_check"],"claim":"Stale revision/hash UI actions reject before graph mutation; startup proves actual no-page failure without fabricating a browser interaction.","id":"sv.ui.action-gates","impact":["perception","PROOFS-e s-v behavior"],"phase":"invariant"}
