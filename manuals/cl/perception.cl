-- @proof {"checkedAt":["grant_agent.ui_graph.UiGraph.replace_nodes -> grant_agent.proofs_e_sv.check","grant_agent.proofs_e_sv.self_check"],"claim":"Every resident graph replacement stamps all nodes with its new revision and binds returned changes to the exact current semantic hash and node set.","id":"sv.ui.graph-state","impact":["perception","PROOFS-e s-v behavior"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.ui_graph.diff_graphs -> grant_agent.proofs_e_sv.check","grant_agent.proofs_e_sv.self_check"],"claim":"Semantic graph diffs return each actual added/changed/removed identity exactly once.","id":"sv.ui.delta","impact":["perception","PROOFS-e s-v behavior"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.ui_graph.find_nodes -> grant_agent.proofs_e_sv.check","grant_agent.proofs_e_sv.self_check"],"claim":"UI graph search returns sorted bounded nodes matching exact/substring role/name/id queries or free text; it never returns a nonmatching control.","id":"sv.ui.query","impact":["perception","PROOFS-e s-v behavior"],"phase":"invariant"}
