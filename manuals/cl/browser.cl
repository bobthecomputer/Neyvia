-- @record {"chapter":"c2h-sockets","data":{"effect":"Observe a task-owned loopback socket fixture; the ordered DOM event log is the actual engine outcome","pre":"Owner-selected root; live engine for observation/action; owner grant for agent effects","returns":{"$cl_type":"t32"},"reversible":true,"schema":"neyvia.browser.observe","tool":"neyvia.browser.observe"},"key":"socket.observe","section":"actions"}
