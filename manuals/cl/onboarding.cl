-- @proof {"checkedAt":["neyvia_onboarding.parse_manifest -> proofs_d_onboarding.check_manifest","neyvia_onboarding.run_download -> proofs_d_onboarding.check_manifest/safe_destination","neyvia_onboarding._safe_relative/_check_source","proofs_d_onboarding.self_check"],"claim":"Manifests use plain pack/version IDs, unique safe paths, bounded integer sizes and SHA256; only HTTPS/local file/loopback HTTP are allowed, totals match, throttling is local, and staged paths stay inside the pack folder.","id":"onboarding.manifest-safety","impact":["base/add-on manifest admission","staged filesystem"],"phase":"pre"}
-- @proof {"checkedAt":["neyvia_onboarding.parse_manifest -> neyvia_onboarding._verify_manifest_signature","proofs_d_onboarding.self_check"],"claim":"Remote non-test payload manifests require a provisioned known Ed25519 key, matching fingerprint and valid canonical Unicode signature. Unsigned admission requires test channel or both local manifest and local payloads.","id":"onboarding.signature-authority","impact":["release trust","remote manifest bytes"],"phase":"pre"}
-- @proof {"checkedAt":["neyvia_onboarding.run_download -> proofs_d_onboarding.check_staged_file/check_download_result","neyvia_onboarding._fetch","proofs_d_onboarding.self_check"],"claim":"Every committed and reused file has its declared size and actual SHA256; only all-verified bytes earn a complete receipt and exact completion counters. Corrupt hashes retry once then discard corrupt partial bytes; oversized sources and errors are durably failed.","id":"onboarding.verified-staging","impact":["payload bytes","install receipt","download progress"],"phase":"post"}
-- @proof {"checkedAt":["neyvia_onboarding.run_download -> proofs_d_onboarding.check_staged_file","neyvia_onboarding._fetch","proofs_d_onboarding.self_check"],"claim":"Partial bytes are resumed with HTTP Range or local seeking; completed files with matching receipt identity, size, timestamp and actual SHA256 are reused without another download.","id":"onboarding.resume-reuse","impact":["CDN requests","resume byte progress","staging cache"],"phase":"invariant"}
-- @proof {"checkedAt":["neyvia_onboarding.run_download -> proofs_d_onboarding.check_download_result","proofs_d_onboarding.self_check"],"claim":"A consumed pause request stops at a progress boundary, persists paused status and retains resumable partial bytes; another run finishes verified staging.","id":"onboarding.pause","impact":["worker status","partial bytes"],"phase":"post"}
-- @proof {"checkedAt":["neyvia_onboarding.pack_status -> neyvia_onboarding._installed_pack_error","neyvia_onboarding.pack_status -> proofs_d_onboarding.check_pack_status","neyvia_onboarding.install_pack -> neyvia_onboarding._spawn_worker","neyvia_onboarding.install_pack/run_download -> proofs_d_onboarding.check_staging_scope","proofs_d_onboarding.self_check"],"claim":"Add-on installs run in detached workers, keep separate per-pack status and receipts, expose stagedOnly=true, and never change base-pack status. Installed means every staged file still verifies.","id":"onboarding.addon-isolation","impact":["add-on staging","base staging","system activation boundary"],"phase":"invariant"}
-- @proof {"checkedAt":["neyvia_onboarding.load_pack_manifest","neyvia_onboarding.install_pack/pack_status -> proofs_d_onboarding.check_pack_status","proofs_d_onboarding.self_check"],"claim":"Unknown IDs are rejected; unavailable payloads disclose their gap. Mismatched, broken or missing manifests fail without a target; repairing the manifest clears errors and permits staging.","id":"onboarding.addon-recovery","impact":["add-on catalog","staging retries"],"phase":"pre"}
-- @proof {"checkedAt":["neyvia_onboarding.load_catalog -> proofs_d_onboarding.check_catalog","proofs_d_onboarding.self_check"],"claim":"Every catalog interest references existing registered apps and optional packs.","id":"onboarding.catalog-integrity","impact":["onboarding recommendations","app/pack registry"],"phase":"invariant"}
-- @proof {"checkedAt":["neyvia_onboarding.recommend -> proofs_d_onboarding.check_recommendation","proofs_d_onboarding.self_check"],"claim":"Recommendations form unique unions in catalog order, filter tour chapters by chosen interests while retaining universal chapters, and keep nonempty tours between 60 and 90 seconds.","id":"onboarding.ordered-recommendations","impact":["tier choices","tour playback"],"phase":"post"}
-- @proof {"checkedAt":["neyvia_onboarding.save_state -> proofs_d_onboarding.check_saved","proofs_d_onboarding.self_check"],"claim":"Invalid app/interest/pack choices are rejected before writing. Accepted normalized setup choices persist exactly and firstRun becomes false.","id":"onboarding.choices-durable","impact":["setup state","completed setup"],"phase":"post"}
