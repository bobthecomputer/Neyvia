-- @record {"chapter":"apps","data":{"goal":"Read shared app state before loading its specific manual","inputs":{"$cl_type":"t30"},"steps":[{"action":"state","args":{},"save":"apps"},{"judge":"app-state"}]},"key":"locate-app-state","section":"procedures"}
P locate-app-state():apps=neyvia.state(); J app-state -- Read shared app state before loading its specific manual
V P locate-app-state -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"apps","data":{"goal":"Open a ready app or pane by its catalog alias; actual mounted app/pane effect is mandatory. G: view.state().state.dom.mounted == True. Read the owning app manual for its next action; unfinished apps refuse.","inputs":{"$cl_type":"t33"},"steps":[{"action":"app-open","args":{"app":{"$input":"app"},"target":{"$input":"target"}},"check":"app-shell-mounted","save":"effect"}]},"key":"open-app","section":"procedures"}
P open-app(app:str target:str):effect=neyvia.app.open(app:app target:target) C app-shell-mounted -- Open a ready app or pane by its catalog alias; actual mounted app/pane effect is mandatory. G: view.state().state.dom.mounted == True. Read the owning app manual for its next action; unfinished apps refuse.
V P open-app -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"apps","data":{"constraints":"App state must contain supported observer data; requests are not rendered observations. Choose app manual by actual goal.","options":["use-app-manual","await-user-side"],"question":"Is the app state current enough to act?"},"key":"app-state","section":"judge"}
J app-state use-app-manual|await-user-side:"Is the app state current enough to act?" -- App state must contain supported observer data; requests are not rendered observations. Choose app manual by actual goal.
V J app-state -> human:operator why:"explicit choice required"
