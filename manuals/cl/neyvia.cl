C neyvia.app.open app-shell-mounted: neyvia.view.state().state.dom.mounted==true
-- @record {"chapter":"apps","data":{"effect":"Persist the requested state and verify the exact native effect; app/pane/layout completion requires a fresh mounted renderer.","pre":"Use a current observer G and an explicitly requested target; unavailable runtimes refuse completion.","returns":{"$cl_type":"t32"},"reversible":true,"schema":"neyvia.view.state","tool":"neyvia.view.state"},"key":"shell-state","section":"actions"}
