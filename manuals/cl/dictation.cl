-- @manual {"chapters":{"overview":{"title":"Local speech engine: availability and authorized file transcription"},"prompts":{"title":"Prompt dictation in the composer, new chat and Notes: live words, spoken commands, language routing, names"}},"clVersion":"1.1","id":"dictation","kind":"environment","proofs":{"area":"dictation"},"schema":"neyvia.manual.v1","schemas":{"neyvia.dictation.names":"t1","neyvia.dictation.process":"t2","neyvia.dictation.status":"t3","neyvia.dictation.transcribe":"t4"},"tool_metadata":{"neyvia.dictation.names":{"mutability_class":"none"},"neyvia.dictation.process":{"mutability_class":"none"},"neyvia.dictation.status":{"mutability_class":"read"},"neyvia.dictation.transcribe":{"mutability_class":"none"}}}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation.names","grant_agent.proofs_dictation.after"],"claim":"Name add/remove persists exactly the requested aliases and the names observer reports persisted plus built-in aliases.","id":"dictation.names.persisted","impact":[".neyvia/dictation-names.json","dictation.process","dictation stream/finalization"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation.names","grant_agent.proofs_dictation.after","grant_agent.proofs_dictation.self_check"],"claim":"Names are read and written only under the selected state root; a name taught in one workspace does not change another workspace's prompt policy.","id":"dictation.names.scoped","impact":["workspace dictation policy","other workspaces"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.neyvia_prompt_dictation.process_prompt","grant_agent.neyvia_dictation.process","grant_agent.proofs_dictation.check_prompt"],"claim":"The prompt is assembled only from ordered text segments; preview is required and stable/provisional match finality. An unfinished hypothesis is literal and has no editor commands.","id":"dictation.prompt.structure","impact":["composer preview","Notes prompt","desktop and HTTP dictation"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.neyvia_prompt_dictation.process_prompt","grant_agent.proofs_dictation.check_prompt"],"claim":"Known whole and terminal spoken commands become ordered command segments instead of prompt words; emitted commands equal the command segments. Quoted text remains literal in scratch procedures.","id":"dictation.prompt.commands","impact":["editor spoken commands","send preview"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.neyvia_prompt_dictation.process_prompt","grant_agent.proofs_dictation.check_prompt"],"claim":"French and mixed utterances select qwen, while English and unknown select phonon2; the French utterance goal is exercised by the shared parser.","id":"dictation.prompt.route","impact":["speech engine routing","local fallback availability"],"phase":"invariant"}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation.stream","grant_agent.proofs_dictation.validate_stream"],"claim":"Unknown stream operations, invalid ids, oversized chunks, odd PCM and negative sequences are rejected before any settings lookup, session allocation, timer or speech-engine call.","id":"dictation.stream.preallocation","impact":["stream sessions","PCM memory","speech engine calls"],"phase":"pre"}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation_providers.Transcript","grant_agent.neyvia_dictation.stream","grant_agent.proofs_dictation.provider_checks"],"claim":"Live words from a streaming provider only grow in order: deltas of the segment being heard stay provisional, a segment locks only when it and every earlier one are complete, and a locked segment is never edited. Checked with the recorded sample fed in 250 ms pieces to a scripted provider.","id":"dictation.provider.partials","impact":["live dictation words","stable/grey split","Voice settings provider choice"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation_providers.OpenAIStream.finish","grant_agent.neyvia_dictation.stream","grant_agent.proofs_dictation.provider_checks"],"claim":"Release commits the provider's audio, waits for the completed segments, and returns one final text that still goes through the prompt policy and preview.","id":"dictation.provider.finalise","impact":["final dictation text","send preview"],"phase":"post"}
-- @proof {"checkedAt":["grant_agent.neyvia_dictation_providers.choose","grant_agent.neyvia_dictation._stream_step","grant_agent.proofs_dictation.provider_checks"],"claim":"A provider that is not usable (no key, local-only on, address not api.openai.com, Codex signed in with a ChatGPT plan, or a connection that drops mid-dictation) never loses speech: the local engine takes over with all audio heard so far, numbered from zero, and one plain sentence says so.","id":"dictation.provider.fallback","impact":["dictation provider choice","local engine","network policy"],"phase":"invariant"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationReveal.js:wordsShown -> checkedDictationAction -> DICTATION_CONTRACTS.wordsShown"],"claim":"Paced words never go backwards or past the engine's answer, the first word of a batch shows at once, and the whole batch shows by the next answer.","id":"dictation.reveal","impact":["live dictation strip","composer ghost text"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationProviders.js:providerChoices -> checkedDictationAction -> DICTATION_CONTRACTS.providerChoices"],"claim":"Settings lists local first as the default, an unavailable provider always carries one plain reason, and at most the chosen provider is selected.","id":"dictation.providers","impact":["Voice settings"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:shiftAnchor -> checkedDictationAction -> DICTATION_CONTRACTS.shiftAnchor"],"claim":"Insertion at/before the caret follows typing; edits after it retain the prefix anchor","id":"dictation.anchor","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:endsMidSentence -> checkedDictationAction -> DICTATION_CONTRACTS.endsMidSentence"],"claim":"Only an unterminated nonblank line continues a sentence","id":"dictation.sentence-state","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:joinSpoken -> checkedDictationAction -> DICTATION_CONTRACTS.joinSpoken"],"claim":"Preserve the field prefix, sentence capitalization, names and punctuation spacing","id":"dictation.join","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:lastSentenceStart -> checkedDictationAction -> DICTATION_CONTRACTS.lastSentenceStart"],"claim":"The last sentence starts after the latest complete terminator or line boundary","id":"dictation.sentence-boundary","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:dropLastPhrase -> checkedDictationAction -> DICTATION_CONTRACTS.dropLastPhrase"],"claim":"Scratch removes only the final phrase and its joining horizontal spaces","id":"dictation.scratch","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:dropLastSentence -> checkedDictationAction -> DICTATION_CONTRACTS.dropLastSentence"],"claim":"Delete only the final sentence, preserving prior lines","id":"dictation.delete-sentence","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:applySegments -> checkedDictationAction -> DICTATION_CONTRACTS.applySegments"],"claim":"Execute segments in order; preserve suffix; cancel restores original; caller owns send/undo/history","id":"dictation.edit","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:previewParts -> checkedDictationAction -> DICTATION_CONTRACTS.previewParts"],"claim":"Preview uses commit spacing/capitalization while retaining stable/provisional separation","id":"dictation.preview","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:withoutOverlap -> checkedDictationAction -> DICTATION_CONTRACTS.withoutOverlap"],"claim":"Remove the longest settled suffix or complete decode prefix, preserving fresh words","id":"dictation.overlap","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:normalizeAnswer -> checkedDictationAction -> DICTATION_CONTRACTS.normalizeAnswer"],"claim":"Legacy partial/final text remains usable; current stable words and command segments survive normalization","id":"dictation.answer","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
-- @proof {"checkedAt":["web/src/neyvia/next/nxDictationEdit.js:liveCommands -> checkedDictationAction -> DICTATION_CONTRACTS.liveCommands"],"claim":"Command chips contain only decided commands in stream order","id":"dictation.commands","impact":["prompt composer text/caret","Notes dictation text","stream provisional overlay"],"phase":"post"}
