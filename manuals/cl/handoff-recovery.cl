-- @record {"chapter":"intake","data":{"effect":"Return body, relative path, tags, pinned and nanosecond modified stamp","pre":"Existing .md/.markdown/.txt resolved beneath notes folder, at most 2 MiB","returns":{"$cl_type":"t8"},"reversible":true,"schema":"neyvia.notes.read","tool":"neyvia.notes.read"},"key":"notes.read","section":"actions"}
