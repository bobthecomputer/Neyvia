T t1 json:"{\"type\":\"object\",\"properties\":{\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"}},\"required\":[\"from\",\"to\"],\"allOf\":[{\"properties\":{\"from\":{\"not\":{\"enum\":[\"\"]}},\"to\":{\"not\":{\"enum\":[\"\"]}}}}]}"
