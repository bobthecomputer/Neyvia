-- @record {"chapter":"intake","data":{"goal":"Move the explicitly reviewed draft, append its #ready receipt once and pin it","inputs":{"$cl_type":"t10"},"steps":[{"action":"notes.read","args":{"path":{"$input":"path"}},"save":"before"},{"action":"files.stat","args":{"path":{"$input":"source"},"preview":true},"save":"selected"},{"judge":"approval"},{"action":"files.move","args":{"from":{"$input":"source"},"to":{"$input":"target"}},"save":"moved","when":{"judge":"approval","option":"approved"}},{"action":"notes.write","args":{"body":{"$input":"message"},"expectedModified":{"$result":"before.modified"},"mode":"append","path":{"$input":"path"}},"check":"captured","save":"written","when":{"judge":"approval","option":"approved"}},{"action":"notes.pin","args":{"path":{"$input":"path"},"pinned":true},"check":"pinned","save":"pin","when":{"judge":"approval","option":"approved"}}]},"key":"stage-reviewed","section":"procedures"}
P stage-reviewed(path:str message:str source:str target:str):before=neyvia.notes.read(path:path); selected=neyvia.files.stat(path:source preview:true); J approval=approved; moved=neyvia.files.move(from:source to:target); written=neyvia.notes.write(body:message expectedModified:before.modified mode:"append" path:path) C captured; pin=neyvia.notes.pin(path:path pinned:true) C pinned -- Move the explicitly reviewed draft, append its #ready receipt once and pin it
V P stage-reviewed -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"intake","data":{"goal":"Hold unreviewed draft and append/pin a #needs-review receipt","inputs":{"$cl_type":"t10"},"steps":[{"action":"notes.read","args":{"path":{"$input":"path"}},"save":"before"},{"judge":"receipt"},{"action":"notes.write","args":{"body":{"$input":"message"},"expectedModified":{"$result":"before.modified"},"mode":"append","path":{"$input":"path"}},"check":"captured","save":"written","when":{"judge":"receipt","option":"record"}},{"action":"notes.pin","args":{"path":{"$input":"path"},"pinned":true},"check":"pinned","save":"pin","when":{"judge":"receipt","option":"record"}}]},"key":"record-review","section":"procedures"}
P record-review(path:str message:str source:str target:str):before=neyvia.notes.read(path:path); J receipt=record; written=neyvia.notes.write(body:message expectedModified:before.modified mode:"append" path:path) C captured; pin=neyvia.notes.pin(path:path pinned:true) C pinned -- Hold unreviewed draft and append/pin a #needs-review receipt
V P record-review -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"intake","data":{"goal":"Preserve both colliding drafts and append/pin a #blocked receipt","inputs":{"$cl_type":"t10"},"steps":[{"action":"notes.read","args":{"path":{"$input":"path"}},"save":"before"},{"judge":"receipt"},{"action":"notes.write","args":{"body":{"$input":"message"},"expectedModified":{"$result":"before.modified"},"mode":"append","path":{"$input":"path"}},"check":"captured","save":"written","when":{"judge":"receipt","option":"record"}},{"action":"notes.pin","args":{"path":{"$input":"path"},"pinned":true},"check":"pinned","save":"pin","when":{"judge":"receipt","option":"record"}}]},"key":"record-blocked","section":"procedures"}
P record-blocked(path:str message:str source:str target:str):before=neyvia.notes.read(path:path); J receipt=record; written=neyvia.notes.write(body:message expectedModified:before.modified mode:"append" path:path) C captured; pin=neyvia.notes.pin(path:path pinned:true) C pinned -- Preserve both colliding drafts and append/pin a #blocked receipt
V P record-blocked -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"intake","data":{"goal":"Guarded idempotent capture with a fresh read and an explicit record/skip decision","inputs":{"$cl_type":"t10"},"steps":[{"action":"notes.read","args":{"path":{"$input":"path"}},"save":"before"},{"judge":"capture"},{"action":"notes.write","args":{"body":{"$input":"message"},"expectedModified":{"$result":"before.modified"},"mode":"append","path":{"$input":"path"}},"check":"captured","save":"written","when":{"judge":"capture","option":"record"}},{"action":"notes.pin","args":{"path":{"$input":"path"},"pinned":true},"check":"pinned","save":"pin","when":{"judge":"capture","option":"record"}}]},"key":"capture-once","section":"procedures"}
P capture-once(path:str message:str source:str target:str):before=neyvia.notes.read(path:path); J capture=record; written=neyvia.notes.write(body:message expectedModified:before.modified mode:"append" path:path) C captured; pin=neyvia.notes.pin(path:path pinned:true) C pinned -- Guarded idempotent capture with a fresh read and an explicit record/skip decision
V P capture-once -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"intake","data":{"goal":"Restore the selected staged draft without undoing unrelated Files operations; append/pin #restored receipt","inputs":{"$cl_type":"t10"},"steps":[{"action":"notes.read","args":{"path":{"$input":"path"}},"save":"before"},{"action":"files.stat","args":{"path":{"$input":"source"},"preview":true},"save":"selected"},{"judge":"restore"},{"action":"files.move","args":{"from":{"$input":"source"},"to":{"$input":"target"}},"save":"moved","when":{"judge":"restore","option":"restore"}},{"action":"notes.write","args":{"body":{"$input":"message"},"expectedModified":{"$result":"before.modified"},"mode":"append","path":{"$input":"path"}},"check":"captured","save":"written","when":{"judge":"restore","option":"restore"}},{"action":"notes.pin","args":{"path":{"$input":"path"},"pinned":true},"check":"pinned","save":"pin","when":{"judge":"restore","option":"restore"}}]},"key":"restore-selected","section":"procedures"}
P restore-selected(path:str message:str source:str target:str):before=neyvia.notes.read(path:path); selected=neyvia.files.stat(path:source preview:true); J restore=restore; moved=neyvia.files.move(from:source to:target); written=neyvia.notes.write(body:message expectedModified:before.modified mode:"append" path:path) C captured; pin=neyvia.notes.pin(path:path pinned:true) C pinned -- Restore the selected staged draft without undoing unrelated Files operations; append/pin #restored receipt
V P restore-selected -> script why:"typed manual runner; stops at every judgement"
-- @record {"chapter":"intake","data":{"constraints":"Choose skip when already captured. Otherwise record only by guarded append. A failed conflict run is not resumable: reconcile actual note, restart fresh and choose skip if message already exists.","options":["record","skip"],"question":"Does the exact message already occur in before.body?"},"key":"capture","section":"judge"}
J capture record|skip:"Does the exact message already occur in before.body?" -- Choose skip when already captured. Otherwise record only by guarded append. A failed conflict run is not resumable: reconcile actual note, restart fresh and choose skip if message already exists.
V J capture -> human:operator why:"explicit choice required"
-- @record {"chapter":"intake","data":{"constraints":"Only explicit reviewed approval with absent destination allows the move. Pending review uses record-review; collisions use record-blocked. Do not overwrite or invent another destination.","options":["approved","stop"],"question":"Is the draft reviewed and its exact destination absent?"},"key":"approval","section":"judge"}
J approval approved|stop:"Is the draft reviewed and its exact destination absent?" -- Only explicit reviewed approval with absent destination allows the move. Pending review uses record-review; collisions use record-blocked. Do not overwrite or invent another destination.
V J approval -> human:operator why:"explicit choice required"
-- @record {"chapter":"intake","data":{"constraints":"Record the exact tagged message in the selected note; preserve draft bytes. Pin the receipt so Paul can find it.","options":["record","stop"],"question":"Is this the authorized handoff receipt for the selected task?"},"key":"receipt","section":"judge"}
J receipt record|stop:"Is this the authorized handoff receipt for the selected task?" -- Record the exact tagged message in the selected note; preserve draft bytes. Pin the receipt so Paul can find it.
V J receipt -> human:operator why:"explicit choice required"
-- @record {"chapter":"intake","data":{"constraints":"Restore by explicit files.move. Global files.undo targets the most recent operation and must not undo another operation.","options":["restore","stop"],"question":"Is source the selected staged draft and target its original absent path?"},"key":"restore","section":"judge"}
J restore restore|stop:"Is source the selected staged draft and target its original absent path?" -- Restore by explicit files.move. Global files.undo targets the most recent operation and must not undo another operation.
V J restore -> human:operator why:"explicit choice required"
-- @record {"chapter":"intake","data":{"failure":"notes.write returns ok=false status=conflict after another editor changed the note","recovery":"Do not drop expectedModified or resume the failed run. Start a fresh capture-once run, inspect before.body, then record or skip. Retain concurrent editor text."},"key":"0","section":"pitfalls"}
X notes.write returns ok=false status=conflict after another editor changed the note -> Do not drop expectedModified or resume the failed run. Start a fresh capture-once run, inspect before.body, then record or skip. Retain concurrent editor text.
-- @record {"chapter":"intake","data":{"failure":"A destination exists","recovery":"Do not rename the destination, overwrite, undo it or choose a suffix. Keep both originals and record-blocked with #blocked."},"key":"1","section":"pitfalls"}
X A destination exists -> Do not rename the destination, overwrite, undo it or choose a suffix. Keep both originals and record-blocked with #blocked.
-- @record {"chapter":"intake","data":{"failure":"Another Files operation followed staging","recovery":"Use restore-selected with the staged path as source and original path as target. Never call global files.undo."},"key":"2","section":"pitfalls"}
X Another Files operation followed staging -> Use restore-selected with the staged path as source and original path as target. Never call global files.undo.
