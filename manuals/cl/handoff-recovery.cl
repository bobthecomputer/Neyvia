T t5 json:"{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"replace\",\"append\"]},\"expectedModified\":{\"type\":\"string\"}},\"required\":[\"body\"],\"allOf\":[{\"properties\":{\"body\":{\"not\":{\"enum\":[\"\"]}}}}]}"
T t6{}
T t7{folder:str exists:bool notes:json:"{\"type\":\"array\"}" tags:json:"{\"type\":\"array\"}" ..}
