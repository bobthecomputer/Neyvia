-- @proof {"checkedAt":["mission_control.ControlRoomStore._compact_flight_recorder_payload -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Flight-recorder projection preserves written phase, process IDs and bounded event history; absent or invalid snapshots never invent events.","id":"proofs-c.missions.local-flight","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.mission_hard_artifact_gate -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Hard artifact completion requires both meaningful runtime output and concrete artifact evidence; either missing boundary stays failed.","id":"proofs-c.missions.local-artifact-gate","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._complete_repaired_hard_artifact_gate_from_detail -> proofs_c_missions.check_local_projection","mission_control._complete_repaired_planned_scope_artifact_gate_from_detail -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Artifact repair completes only after the failed gate is actually ready and no unrelated failures remain; rejected repairs preserve mission state and successful repair is durable.","id":"proofs-c.missions.local-artifact-repair","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._public_launch_readiness_digest -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Public-launch digest selects the freshest saved evidence and preserves operator repair/publication fields; missing receipts cannot claim readiness.","id":"proofs-c.missions.local-public-launch","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
