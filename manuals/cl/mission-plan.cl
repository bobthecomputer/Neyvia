-- @proof {"checkedAt":["mission_receipts.load_mission_receipts -> proofs_c_missions.check_receipt_read","proofs_c_missions.self_check"],"claim":"Receipt reads skip malformed rows, filter by mission before limiting and preserve durable stream order.","id":"proofs-c.missions.receipt-filter","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
