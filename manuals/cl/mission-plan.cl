-- @proof {"checkedAt":["mission_control.ControlRoomStore._mission_runtime_transcript_payload -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Transcript attachment requires concrete output or artifact evidence, retains rejected-session evidence, prefers the latest concrete session, and exposes missing evidence without synthetic messages.","id":"proofs-c.missions.local-transcript","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._mission_agent_messages_payload -> proofs_c_missions.check_local_projection","proofs_c_missions.self_check"],"claim":"Agent-message projection preserves dialogue receipts and marks control-room planning, actions, heartbeats and integrity notes as trace-only bookkeeping.","id":"proofs-c.missions.local-messages","impact":["mission evidence projection","truthful completion","operator repair"],"phase":"invariant"}
