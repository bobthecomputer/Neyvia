-- @proof {"checkedAt":["mission_artifacts.build_mission_run_artifact_layout -> proofs_c_missions.check_layout","proofs_c_missions.self_check"],"claim":"File-safe mission IDs confine all layout paths to their canonical mission root; create builds the directories and create=false does not write.","id":"proofs-c.missions.artifact-layout","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_phase_inputs.build_executor_phase_input -> proofs_c_missions.check_capsule","proofs_c_missions.self_check"],"claim":"Executor handoff contains bounded goal/compact plan/selected skill IDs/file scope; wrong schemas and planner-only raw context are excluded.","id":"proofs-c.missions.executor-boundary","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_phase_inputs.build_verifier_phase_input -> proofs_c_missions.check_capsule","proofs_c_missions.self_check"],"claim":"Verifier handoff contains compact goal/plan/execution and ordered deduplicated changed files/artifacts; runtime metadata is excluded.","id":"proofs-c.missions.verifier-boundary","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_phase_inputs.check_selected_skill_relevance -> proofs_c_missions.check_relevance","proofs_c_missions.self_check"],"claim":"Empty skill selection blocks and irrelevant selected skills need review; counts exactly reflect inspected selection.","id":"proofs-c.missions.skill-relevance","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_phase_runner.start_current_phase/complete_current_phase -> proofs_c_missions.check_run","proofs_c_missions.self_check"],"claim":"Mission envelopes preserve lifecycle vocabulary, known schema, parseable timestamps and independently owned mutable state.","id":"proofs-c.missions.run-envelope","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_phase_runner.complete_current_phase -> proofs_c_missions.check_transition","proofs_c_missions.self_check"],"claim":"Phase control follows accepted successors/status, preserves receipt references, bounds repair loops, blocks exhausted repair and refuses terminal/completed restarts.","id":"proofs-c.missions.phase-transition","impact":["mission handoff","durable receipts","operator status"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_acceptance_harness.MissionAcceptanceHarness.run -> proofs_c_missions.check_acceptance","proofs_c_missions.self_check"],"claim":"The five simulated local harness journeys produce exact durable summaries and distinct attempt receipts; receipt flags clearly exclude real external/model execution.","id":"proofs-c.missions.acceptance-receipt","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
-- @proof {"checkedAt":["continuity_policy.MissionContinuityStore._create_or_update_unlocked/load -> proofs_c_missions.check_continuity_write/check_continuity_recovery","proofs_c_missions.self_check"],"claim":"Continuity writes under the mission lock increment the current revision once, persist exact facts and preserve the preceding valid snapshot; corrupt state recovers previous facts without inventing progress.","id":"proofs-c.missions.continuity-durable","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
-- @proof {"checkedAt":["continuity_policy.MissionContinuityStore.evaluate_gpu_action -> proofs_c_missions.check_gpu","proofs_c_missions.self_check"],"claim":"GPU decisions preserve estimated session cost, policy blockers, and duration/idle release requirements.","id":"proofs-c.missions.gpu-policy","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
-- @proof {"checkedAt":["security_runtime_policy.evaluate_security_action/build_purple_team_plan -> proofs_c_missions.check_security/check_security_plan","proofs_c_missions.self_check"],"claim":"Active security decisions require authorized owner/target/action scope and action-time approval where required; invalid budgets normalize safely and purple-team phases keep auditor/red/blue/defender separation.","id":"proofs-c.missions.security-scope","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
-- @proof {"checkedAt":["security_runtime_policy.audit_security_tool_coverage -> proofs_c_missions.check_security_coverage","proofs_c_missions.self_check"],"claim":"Security phase readiness exactly matches executable candidates; planned/unavailable tools never satisfy missing defensive coverage.","id":"proofs-c.missions.security-coverage","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.apply_agent_turn_mode_to_launch -> proofs_c_missions.check_turn_mode","proofs_c_missions.self_check"],"claim":"Turn modes preserve the goal and checks: plan adds the written-plan gate, fast lowers effort and caps a selected budget, max-context raises effort and Deep Run budget, standard preserves semantics.","id":"proofs-c.missions.turn-mode","impact":["mission runtime","durable receipts","authority admission"],"phase":"invariant"}
