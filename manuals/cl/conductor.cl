-- @proof {"checkedAt":["mission_control.ControlRoomStore.load_workspaces -> proofs_c_control.checked(workspaces)","proofs_c_control.self_check"],"claim":"Empty or malformed stores create and persist the primary workspace. Existing release roots reanchor within their release family; unrelated project roots remain unchanged. The returned projection equals durable state.","id":"proofs-c.control.workspaces","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore.delete_workspace -> proofs_c_control.checked(delete)","proofs_c_control.self_check"],"claim":"Workspace removal preserves unrelated workspaces, missions and history, removes only the selected workspace mission projection/history, and returns the exact removal count. The last workspace and unknown IDs are rejected by the action.","id":"proofs-c.control.delete","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._rebalance_workspace_queue_in_place -> proofs_c_control.checked(queue)","proofs_c_control.self_check"],"claim":"Each workspace has exactly one eligible active slot, contiguous queued positions and actual blocker identities. Completed, blocked and exhausted owners release their queue position; newly promoted queued work receives its front-of-queue receipt.","id":"proofs-c.control.queue","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore.recent_events -> proofs_c_control.checked(events)","proofs_c_control.self_check"],"claim":"Event reads return only the requested durable tail in newest-first order, skip malformed rows and obey zero/negative bounds.","id":"proofs-c.control.events","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._load_json -> proofs_c_control.checked(cache)","proofs_c_control.self_check"],"claim":"Unchanged file metadata reuses the same cached parse object; new small parses enter the cache and durable writes invalidate stale cached values.","id":"proofs-c.control.cache","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.mission_mode_to_engine_mode -> proofs_c_control.checked(mode)","proofs_c_control.self_check"],"claim":"Desktop Focus/Autopilot/Deep Run/Research modes select fast/autopilot/deep_run/swarms engines, with autopilot for unknown vocabulary.","id":"proofs-c.control.mode","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._mission_title -> proofs_c_control.checked(title)","proofs_c_control.self_check"],"claim":"Mission titles remove prompt filler, preserve significant words in order, omit secondary stopwords, capitalize the opening token, bound length to six tokens and use New Mission for empty input.","id":"proofs-c.control.title","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.infer_planned_file_scope -> proofs_c_control.checked(scope)","proofs_c_control.self_check"],"claim":"File scopes are bounded, deduplicated normalized paths. Explicit artifact destinations and fusion workspaces are retained, while separately labelled source projects and validation prose do not become edit targets.","id":"proofs-c.control.scope","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.mission_time_budget_window -> proofs_c_control.checked(budget)","proofs_c_control.self_check"],"claim":"Runtime budget values are nonnegative; an explicit persisted deadline determines maximum duration, elapsed and remaining time over the nominal duration, while recorded running continuation windows retain their established precedence.","id":"proofs-c.control.budget","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._verification_summary_for_mission -> proofs_c_control.checked(verification)","proofs_c_control.self_check"],"claim":"Failed verification labels structured checks by checkId/id/label/title/message/detail/status priority and reports at most two, rather than rendering mapping representations as user-facing failure names.","id":"proofs-c.control.verification","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._build_generated_image_artifacts_snapshot -> proofs_c_control.checked(images)","proofs_c_control.self_check"],"claim":"Image artifact summaries match retained items, direct files retain their stem identity, and previews bind to existing sufficiently sized artifact files.","id":"proofs-c.control.images","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.attach_verifier_proof_bundle -> proofs_c_control.checked(attachment)","proofs_c_control.self_check"],"claim":"Verifier screenshots/reports are confined to the supplied workspace, copied byte faithfully and stored beside a durable manifest with exact schema/count/size. External paths are rejected and cannot publish an attachment manifest.","id":"proofs-c.control.attachment","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._recover_evidence_path -> proofs_c_control.checked(evidence)","proofs_c_control.self_check"],"claim":"An existing embedded Windows runtime evidence path is recovered to that actual file rather than retaining the malformed prefix.","id":"proofs-c.control.evidence","impact":["control-room state","mission lifecycle","operator evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._goal_completion_audit_summary -> proofs_c_control.checked(goal-audit)","proofs_c_control.self_check"],"claim":"Recorded first-view proof can satisfy interface evidence. Completed/real-output evidence and clean advancing cadence determine output/red-team requirements. Weighted counts, completion percentage and top blocker agree with actual requirement rows; missing mission output remains partial.","id":"proofs-c.control.goal-audit","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._system_loss_breakdown -> proofs_c_control.checked(loss-audit)","proofs_c_control.self_check"],"claim":"Quiet completed queues with an explicit healthy queue receipt are not a missing-live-work gap. Clean advancing red-team cadence stays visible as zero-loss maintenance; unhealthy cadence retains a positive product gap. Loss averages match recorded category scores.","id":"proofs-c.control.loss-audit","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._storage_triage_summary -> proofs_c_control.checked(storage-triage)","proofs_c_control.self_check"],"claim":"An unmeasured connect/timeout failure produces a warning rather than a measured full-disk block. Triage executes no destructive action; this projection consumes recorded pressure input without probing NAS.","id":"proofs-c.control.storage-triage","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.mission_artifact_manifest_preview_url -> proofs_c_control.checked(preview)","proofs_c_control.self_check"],"claim":"A mission preview uses its actual artifact manifest, explicit entrypoint or bare index.html; absent files provide no fabricated preview.","id":"proofs-c.control.preview","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._mission_proof_digest_payload -> proofs_c_control.checked(proof-digest)","proofs_c_control.self_check"],"claim":"A current live-view URL takes precedence over a persisted artifact manifest. Without a live-view URL, the mission artifact binds into the proof digest with its correct source label. URL binding alone is not serving/browser proof.","id":"proofs-c.control.proof-digest","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._mission_summary_payload -> proofs_c_control.checked(progress)","proofs_c_control.self_check"],"claim":"Mission progress uses recorded actions/runtime lanes, treats failed work as bounded proof repair, queued work as four-percent queued state, and exhausted work as non-completion attention. Fresh/extended active windows preserve an activity floor and renewed denominator; planned artifact counts match measured local entries.","id":"proofs-c.control.progress","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._control_mission_counts_projection -> proofs_c_control.checked(mission-counts)","proofs_c_control.self_check"],"claim":"Pure mission lifecycle counters distinguish active, blocked, queued and runtime-budget attention from persisted mission facts. Startup checks do not prove full summary aggregate wiring; its two original cases remain retained.","id":"proofs-c.control.mission-counts","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._control_workspace_queue_projection -> proofs_c_control.checked(workspace-queue)","proofs_c_control.self_check"],"claim":"Every shell collector uses the same actual active/queued workspace ownership projection. Eligible queue owners exclude released, exhausted and reconcile-pending missions; queue IDs and counts match recorded rows.","id":"proofs-c.control.workspace-queue","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._build_route_trust_coverage_summary -> proofs_c_control.checked(route-trust)","proofs_c_control.self_check"],"claim":"Only useful operator-scored feedback reduces missing route-value samples. Low-value closeouts require prioritized artifact/browser/proof/value repair, with explicit model policy. Declared sample objectives outrank unrelated workspace route defaults.","id":"proofs-c.control.route-trust","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._release_quality_score -> proofs_c_control.checked(release-quality)","proofs_c_control.self_check"],"claim":"Release quality uses bounded completed-or-continuing and resume-completed-or-continuing components while preserving terminal completion statistics. This calculation does not collect release/supervisor state.","id":"proofs-c.control.release-quality","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._build_notification_feed -> proofs_c_control.checked(notifications)","proofs_c_control.self_check"],"claim":"Notification rows refer only to current mission IDs and are bounded. Completed concrete runtime output yields a source-labelled slice, while running output can hydrate from the mission’s local runtime ledger; no provider discovery is needed.","id":"proofs-c.control.notifications","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._overnight_progress_projection -> proofs_c_control.checked(overnight)","proofs_c_control.self_check"],"claim":"Mission-only overnight projection separates actionable repair from safely held overlap queues, preserving owner identity, repair/held counts and split-scope guidance. Delivery/channel collection remains outside the scratch projector.","id":"proofs-c.control.overnight","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._build_git_actions -> proofs_c_control.checked(git-actions)","proofs_c_control.self_check"],"claim":"Tracked branches expose fast-forward-only pull and scoped commit suggestions. Approval-gated pull remains gated and action order is inspect, pull, commit, push. Projection never executes git pull/push.","id":"proofs-c.control.git-actions","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control._build_validation_actions -> proofs_c_control.checked(validation-actions)","proofs_c_control.self_check"],"claim":"The workspace exposes one real validation action on validate.workspace, including the frontend build command detected from local package.json. Projection does not execute that declared command.","id":"proofs-c.control.validation-actions","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.ControlRoomStore._write_json_if_changed -> proofs_c_control.checked(replace-lock)","proofs_c_control.self_check"],"claim":"Successful atomic writes equal the submitted JSON. The Windows startup procedure holds a real read lease denying delete-sharing, releases it while the production retry loop runs, verifies exact durable content, preserves an unrelated keeper and leaves no staging file.","id":"proofs-c.control.replace-lock","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
-- @proof {"checkedAt":["mission_control.build_summary_harness_lab_snapshot -> proofs_c_control.checked(harness-summary)","proofs_c_control.self_check"],"claim":"Harness summary counts only mission-index sessions and explicitly defers unrelated runtime history. Terminal completion, live continuity and resumed completion/continuity rates retain distinct denominators.","id":"proofs-c.control.harness-summary","impact":["mission state projection","operator decisions","durable evidence"],"phase":"invariant"}
