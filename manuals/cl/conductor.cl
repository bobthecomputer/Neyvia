-- @proof {"checkedAt":["grant_agent.cli._run_mission_watchdog_pass before state write","grant_agent.proofs_a_cli_preferences"],"claim":"Scoped one-shot watchdog passes preserve active ongoing loop identity and counts; ongoing passes retain own liveness.","id":"a-cli.preferences.watchdog","impact":["Scoped one-shot watchdog passes preserve active ongoing loop identity and counts; ongoing passes retain own liveness."],"phase":"post"}
