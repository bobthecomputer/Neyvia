{
  "schema": "neyvia.manual.v1",
  "id": "local-mechanisms",
  "kind": "workflow",
  "schemas": {
    "context.compact": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "targetRatio": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.8
        },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2000000
        }
      },
      "required": [
        "sessionId"
      ],
      "allOf": [
        {
          "properties": {
            "sessionId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "lab.compare": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "targets": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "workId": {
          "type": "string"
        }
      },
      "required": [
        "identity",
        "targets",
        "workId"
      ],
      "allOf": [
        {
          "properties": {
            "identity": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "workId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "lab.competition": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "workId": {
          "type": "string"
        }
      },
      "required": [
        "identity",
        "source",
        "candidates",
        "instruments",
        "workId"
      ],
      "allOf": [
        {
          "properties": {
            "identity": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "source": {
              "not": {
                "enum": [
                  ""
                ]
              }
            },
            "workId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "lab.instrument": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "json_numeric",
                "image",
                "trace_timing"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "max": {
              "type": "number"
            },
            "maxMeanMs": {
              "type": "number",
              "minimum": 0
            },
            "minWidth": {
              "type": "integer",
              "minimum": 0
            },
            "minHeight": {
              "type": "integer",
              "minimum": 0
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      "required": [
        "identity",
        "spec"
      ],
      "allOf": [
        {
          "properties": {
            "identity": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    }
  },
  "chapters": {
    "mechanisms": {
      "title": "Frozen artifact competition and lossless context compaction",
      "state": {},
      "actions": {
        "context-compact": {
          "effect": "Freeze isolated candidates, measure all candidates against identical criteria, or archive older context without losing original evidence",
          "pre": "Intact local source, frozen instruments and active durable context; selected work preferences enabled",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "context.compact",
          "tool": "context.compact"
        },
        "lab-compare": {
          "effect": "Freeze isolated candidates, measure all candidates against identical criteria, or archive older context without losing original evidence",
          "pre": "Intact local source, frozen instruments and active durable context; selected work preferences enabled",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "lab.compare",
          "tool": "lab.compare"
        },
        "lab-competition": {
          "effect": "Freeze isolated candidates, measure all candidates against identical criteria, or archive older context without losing original evidence",
          "pre": "Intact local source, frozen instruments and active durable context; selected work preferences enabled",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "lab.competition",
          "tool": "lab.competition"
        },
        "lab-instrument": {
          "effect": "Freeze isolated candidates, measure all candidates against identical criteria, or archive older context without losing original evidence",
          "pre": "Intact local source, frozen instruments and active durable context; selected work preferences enabled",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "lab.instrument",
          "tool": "lab.instrument"
        }
      },
      "checks": {},
      "procedures": {
        "verify-context-compact": {
          "goal": "Archive older active context without deleting it, protect recent and pinned evidence, and write a compaction receipt.",
          "inputs": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "targetRatio": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.8
              },
              "maxContextTokens": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 2000000
              }
            },
            "required": [
              "sessionId",
              "focus",
              "targetRatio",
              "maxContextTokens"
            ]
          },
          "steps": [
            {
              "action": "context-compact",
              "args": {
                "focus": {
                  "$input": "focus"
                },
                "maxContextTokens": {
                  "$input": "maxContextTokens"
                },
                "sessionId": {
                  "$input": "sessionId"
                },
                "targetRatio": {
                  "$input": "targetRatio"
                }
              },
              "save": "saved"
            }
          ]
        },
        "verify-lab-compare": {
          "goal": "Measure every competition candidate with the same frozen instruments; never automatically promote",
          "inputs": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "targets": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "workId": {
                "type": "string"
              }
            },
            "required": [
              "identity",
              "targets",
              "workId"
            ]
          },
          "steps": [
            {
              "action": "lab-compare",
              "args": {
                "identity": {
                  "$input": "identity"
                },
                "targets": {
                  "$input": "targets"
                },
                "workId": {
                  "$input": "workId"
                }
              },
              "save": "saved"
            }
          ]
        },
        "verify-lab-competition": {
          "goal": "Create isolated candidate source snapshots under one frozen measurement contract",
          "inputs": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "candidates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "instruments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "workId": {
                "type": "string"
              }
            },
            "required": [
              "identity",
              "source",
              "candidates",
              "instruments",
              "workId"
            ]
          },
          "steps": [
            {
              "action": "lab-competition",
              "args": {
                "candidates": {
                  "$input": "candidates"
                },
                "identity": {
                  "$input": "identity"
                },
                "instruments": {
                  "$input": "instruments"
                },
                "source": {
                  "$input": "source"
                },
                "workId": {
                  "$input": "workId"
                }
              },
              "save": "saved"
            }
          ]
        },
        "verify-lab-instrument": {
          "goal": "Freeze an existing quality instrument for matched artifact evaluation",
          "inputs": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "spec": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "json_numeric",
                      "image",
                      "trace_timing"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max": {
                    "type": "number"
                  },
                  "maxMeanMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minWidth": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minHeight": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "identity",
              "spec"
            ]
          },
          "steps": [
            {
              "action": "lab-instrument",
              "args": {
                "identity": {
                  "$input": "identity"
                },
                "spec": {
                  "$input": "spec"
                }
              },
              "save": "saved"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [
        {
          "failure": "One failed candidate is omitted from a comparison",
          "recovery": "Measure every candidate named by the frozen contract and retain failed criteria."
        },
        {
          "failure": "A compacted receipt hides lost instructions or original messages",
          "recovery": "Freshly compare every old ledger row; protected content stays active and archived content stays retrievable."
        }
      ],
      "frontier": [
        "A frozen local artifact measurement proves its declared criterion, not general model improvement.",
        "Candidate promotion and provider/model execution require their own authority and real journey."
      ],
      "guidance": [
        "Use new competition identities; isolated byte snapshots preserve the original source.",
        "Compaction needs an active bounded ledger. An empty ledger is refused rather than credited as an effect."
      ]
    }
  }
}
