  "chapters": {
    "overview": {
      "title": "Paired PCs: bounded reads and verified copies",
      "state": {
        "devices": {
          "args": {},
          "inputs": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "shape": {
            "type": "object",
            "properties": {
              "here": {
                "type": "object"
              },
              "devices": {
                "type": "array"
              },
              "requests": {
                "type": "array"
              },
              "transfers": {
                "type": "array"
              },
              "tailnet": {
                "type": "string"
              }
            },
            "required": [
              "here",
              "devices",
              "requests",
              "transfers",
              "tailnet"
            ]
          },
          "tool": "neyvia.devices.list"
        },
        "transfers": {
          "args": {},
          "inputs": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "shape": {
            "type": "object",
            "properties": {
              "transfers": {
                "type": "array"
              }
            },
            "required": [
              "transfers"
            ]
          },
          "tool": "neyvia.devices.transfers"
        }
      },
      "actions": {
        "devices.list": {
          "effect": "Read saved PCs/requests/newest 30 transfers and cached tailnet status; online may be stale",
          "pre": "Selected root peer store readable; no discovery/probing required",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.devices.list",
          "tool": "neyvia.devices.list"
        },
        "devices.files.list": {
          "effect": "Read remote places or folder entries (max 2000); refresh advertised theyShare when returned",
          "pre": "Device ID is paired, reachable with DPAPI-protected pair token; path absent for places or inside remote shared folder/inbox",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.devices.files.list",
          "tool": "neyvia.devices.files.list"
        },
        "devices.files.stat": {
          "effect": "Read remote kind/size/mime, optional 64 KiB text preview and SHA-256",
          "pre": "Paired reachable PC; existing path inside its shares/inbox; hash only files <=2 GiB",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.devices.files.stat",
          "tool": "neyvia.devices.files.stat"
        },
        "devices.files.read": {
          "effect": "Read bounded remote bytes, UTF-8 text or base64, size/eof; no local copy",
          "pre": "Paired reachable PC; shared existing file; nonnegative offset and length 0..1 MiB",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.devices.files.read",
          "tool": "neyvia.devices.files.read"
        },
        "devices.files.fetch": {
          "effect": "Create destination folder if missing and start chunk-verified Take; collision gets unique path; wait may return unfinished; use transfer.to",
          "pre": "Paired reachable PC and shared source; safe local destination is/createable as a folder; <=5000 files/50 GiB; artifact-write authority",
          "returns": {
            "type": "object",
            "properties": {
              "transfer": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "device": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer"
                  },
                  "done": {
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "status",
                  "sha256",
                  "device",
                  "from",
                  "to",
                  "size",
                  "done"
                ]
              }
            },
            "required": [
              "transfer"
            ]
          },
          "reversible": false,
          "schema": "neyvia.devices.files.fetch",
          "tool": "neyvia.devices.files.fetch"
        },
        "devices.files.send": {
          "effect": "Start chunk/hash-verified Send without overwrite; wait may return pending; transfer.to is actual received path",
          "pre": "Paired reachable PC; local readable source; remote existing inbox/writable folder; owner grants devices:send:<id>; <=5000 files/50 GiB",
          "returns": {
            "type": "object",
            "properties": {
              "transfer": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "device": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer"
                  },
                  "done": {
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "status",
                  "sha256",
                  "device",
                  "from",
                  "to",
                  "size",
                  "done"
                ]
              }
            },
            "required": [
              "transfer"
            ]
          },
          "reversible": false,
          "schema": "neyvia.devices.files.send",
          "tool": "neyvia.devices.files.send"
        },
        "devices.transfers": {
          "effect": "Read newest 30 matching transfers with progress/status/error and end-to-end SHA-256",
          "pre": "Selected root transfer store readable; optional id selects retained transfer",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.devices.transfers",
          "tool": "neyvia.devices.transfers"
        },
        "files.stat": {
          "effect": "Return kind/size/openWith; preview=true reads first 64 KiB only for text/notes",
          "pre": "Existing guarded path inside a Files place outside protected tree",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.files.stat",
          "tool": "neyvia.files.stat"
        }
      },
      "checks": {
        "transfer-done": {
          "args": {
            "id": {
              "$input": "id"
            }
          },
          "expect": {
            "op": "eq",
            "path": "transfers.0.status",
            "value": "done"
          },
          "tool": "neyvia.devices.transfers"
        },
        "received-size": {
          "args": {
            "path": {
              "$path": "to"
            }
          },
          "expect": {
            "op": "eq",
            "path": "size",
            "value": {
              "$input": "size"
            }
          },
          "tool": "neyvia.files.stat"
        },
        "fresh-fetch-complete": {
          "args": {
            "id": {
              "$result": "copied.transfer.id"
            }
          },
          "expect": {
            "op": "eq",
            "path": "transfers.0.status",
            "value": "done"
          },
          "tool": "neyvia.devices.transfers"
        },
        "fresh-send-complete": {
          "args": {
            "id": {
              "$result": "copied.transfer.id"
            }
          },
          "expect": {
            "op": "eq",
            "path": "transfers.0.status",
            "value": "done"
          },
          "tool": "neyvia.devices.transfers"
        }
      },
      "procedures": {
        "take-file": {
          "goal": "Inspect remote file and copy into existing local folder without overwrite; inspect newest transfers and retain the matching returned ID for separate completion verification",
          "inputs": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "device",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "devices.files.stat",
              "args": {
                "device": {
                  "$input": "device"
                },
                "path": {
                  "$input": "from"
                }
              },
              "save": "source"
            },
            {
              "judge": "take-or-stop"
            },
            {
              "action": "devices.files.fetch",
              "args": {
                "device": {
                  "$input": "device"
                },
                "from": {
                  "$input": "from"
                },
                "to": {
                  "$path": "to"
                }
              },
              "save": "copied",
              "when": {
                "judge": "take-or-stop",
                "option": "take"
              }
            },
            {
              "action": "devices.transfers",
              "args": {},
              "save": "progress",
              "when": {
                "judge": "take-or-stop",
                "option": "take"
              }
            }
          ]
        },
        "send-to-inbox": {
          "goal": "Inspect local source and remote shares, then send a requested file to default inbox; inspect newest transfers and retain the matching returned ID for separate completion verification",
          "inputs": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            },
            "required": [
              "device",
              "from"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "files.stat",
              "args": {
                "path": {
                  "$path": "from"
                }
              },
              "save": "local"
            },
            {
              "action": "devices.files.list",
              "args": {
                "device": {
                  "$input": "device"
                }
              },
              "save": "places"
            },
            {
              "judge": "send-destination"
            },
            {
              "action": "devices.files.send",
              "args": {
                "device": {
                  "$input": "device"
                },
                "from": {
                  "$path": "from"
                }
              },
              "save": "copied",
              "when": {
                "judge": "send-destination",
                "option": "send-inbox"
              }
            },
            {
              "action": "devices.transfers",
              "args": {},
              "save": "progress",
              "when": {
                "judge": "send-destination",
                "option": "send-inbox"
              }
            }
          ]
        },
        "verify-taken-file": {
          "goal": "Inspect a saved Take transfer, confirm done and verify actual received file size",
          "inputs": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "to",
              "size"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "devices.transfers",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "progress"
            },
            {
              "judge": "copy-status"
            },
            {
              "action": "devices.transfers",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "check": "transfer-done",
              "save": "done",
              "when": {
                "judge": "copy-status",
                "option": "verify-done"
              }
            },
            {
              "action": "devices.transfers",
              "args": {
                "id": {
                  "$input": "id"
                }
              },
              "save": "digest",
              "when": {
                "judge": "copy-status",
                "option": "verify-done"
              }
            },
            {
              "action": "files.stat",
              "args": {
                "path": {
                  "$path": "to"
                }
              },
              "check": "received-size",
              "save": "received",
              "when": {
                "judge": "copy-status",
                "option": "verify-done"
              }
            }
          ]
        },
        "copy-file-fetch-verified": {
          "goal": "Copy an already paired explicitly requested regular file <=64 MiB into an explicit folder; conserve source, refuse overwrite, and verify fresh bytes at both endpoints",
          "inputs": {
            "type": "object",
            "properties": {
              "device": {
                "type": "string"
              },
              "from": {
