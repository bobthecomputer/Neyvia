        "runId": {
          "type": "string"
        },
        "background": {
          "type": "boolean"
        },
        "scopeTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runId"
      ],
      "allOf": [
        {
          "properties": {
            "runId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "neyvia.autopilot.start": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        "sessionId": {
          "type": "string"
        },
        "scopeTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "background": {
          "type": "boolean"
        },
        "efficiency": {
          "type": "boolean"
        },
        "appGoal": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "clSource": {
              "type": "string"
            },
            "native": {
              "type": "object"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "project",
            "url"
          ],
          "additionalProperties": false
        },
