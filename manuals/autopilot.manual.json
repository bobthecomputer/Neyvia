    "neyvia.autopilot.stop": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "allOf": [
        {
          "properties": {
            "runId": {
              "not": {
                "enum": [
                  ""
                ]
              }
            }
          }
        }
      ]
    },
    "proofs-e-models.status": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "chapters": {
    "fixcl3-local": {
      "title": "Exact retained local admission and supervision",
      "state": {},
      "actions": {
        "neyvia.autopilot.stop": {
          "effect": "Exact retained autopilot.stop",
          "pre": "Saved disposable/local subject; explicit owner approval for arming or creation; never active provider control",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.autopilot.stop",
          "tool": "neyvia.autopilot.stop"
        }
      },
      "checks": {
        "autopilot-stop-observed": {
          "args": {
            "runId": {
              "$input": "runId"
            }
          },
          "expect": {
            "op": "eq",
            "path": "run.status",
            "value": "stopped"
          },
          "tool": "neyvia.autopilot.get"
        }
      },
      "procedures": {
        "retain-autopilot-stop": {
          "goal": "Requested local autopilot.stop matches fresh owner observation",
          "inputs": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              }
            },
            "required": [
              "runId"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "neyvia.autopilot.stop",
              "args": {
                "runId": {
                  "$input": "runId"
                }
              },
              "check": "autopilot-stop-observed",
              "save": "effect"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [
        {
          "failure": "Fresh owner state differs from this action subject",
          "recovery": "Reconcile the specific retained effect; never replay an uncertain launch."
        }
      ],
      "frontier": [
        "Admission, arming and local starter bytes do not prove provider execution, rendered preview, device build or installation. Active provider controls require a terminal provider witness."
      ],
      "guidance": [
        "CL completion re-reads the owner and compares the exact task graph, source hash, retained control or starter bytes."
      ]
    },
    "fixcl4-real": {
      "title": "Actual provider and manual completion",
      "state": {},
      "actions": {
        "autopilot.start": {
          "effect": "Complete an intent through scoped manuals and executable checks; models only decide branches. Retry requestId safely.",
          "pre": "Explicit selected provider, original caller tool scope and bounded owned workspace",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.autopilot.start",
          "tool": "neyvia.autopilot.start"
        },
        "autopilot.resume": {
          "effect": "Continue a stopped run without replaying completed or uncertain effects; original scope cannot widen.",
          "pre": "Explicit selected provider, original caller tool scope and bounded owned workspace",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.autopilot.resume",
          "tool": "neyvia.autopilot.resume"
        }
      },
      "checks": {},
      "procedures": {
        "verify-autopilot-start": {
