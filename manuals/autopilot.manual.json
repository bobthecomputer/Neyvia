      "judge": {},
      "pitfalls": [
        {
          "failure": "A queued admission or provider call is called completed",
          "recovery": "Read the retained owner and require actual terminal provider/manual receipts and fresh acceptance."
        }
      ],
      "frontier": [
        "Selected provider unavailability or model refusal is retained as a failure; no provider substitution or fabricated output."
      ],
      "guidance": [
        "Reuse the exact request identity and original scope. Completed resumes verify retained effects without replaying completed work.",
        "Select NEYVIA_AUTOPILOT_SMALL_MODEL explicitly for this process before starting a run. Supported routes are gpt-6-luna and gpt-6.1-sol; an unknown route fails before inference. Provider receipts retain the actual model and token usage."
      ]
    },
    "overview": {
      "title": "Autopilot: intent to verified checklist",
      "state": {
        "run": {
          "args": {
            "runId": {
              "$input": "runId"
            }
          },
          "inputs": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              }
            },
            "required": [
              "runId"
            ],
            "additionalProperties": false
          },
          "shape": {
            "type": "object",
            "required": [
              "run"
            ]
          },
          "tool": "neyvia.autopilot.get"
        }
      },
      "actions": {
        "inspect": {
          "effect": "Read authoritative durable receipts",
          "pre": "Returned runId in this workspace",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.autopilot.get",
          "tool": "neyvia.autopilot.get"
        },
        "start": {
          "effect": "Run synchronously through the Native gateway or start background owner HTTP; every ask gets checked receipts",
          "pre": "Explicit intent/requestId and exact scopeTools; caller already holds every nested grant",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.autopilot.start",
          "tool": "neyvia.autopilot.start"
        },
        "list": {
          "effect": "Read durable run states",
          "pre": "Selected workspace",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.autopilot.list",
          "tool": "neyvia.autopilot.list"
        },
        "stop": {
          "effect": "Stop at next action boundary; preserve newest progress and source bytes",
          "pre": "Returned runId",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.autopilot.stop",
          "tool": "neyvia.autopilot.stop"
        },
        "resume": {
          "effect": "Continue retained progress; completed children are never repeated",
          "pre": "Original scope, worker quiesced, no unknown effects or unresolved authority",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.autopilot.resume",
          "tool": "neyvia.autopilot.resume"
        }
      },
      "checks": {
        "completed": {
          "args": {
            "runId": {
              "$input": "runId"
            }
          },
          "expect": {
            "op": "eq",
            "path": "run.status",
            "value": "completed"
          },
          "tool": "neyvia.autopilot.get"
        }
      },
      "procedures": {
        "verify-run": {
          "goal": "Verify that all autopilot asks have executable completion receipts",
          "inputs": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              }
            },
            "required": [
              "runId"
            ],
            "additionalProperties": false
          },
          "steps": [
            {
              "action": "inspect",
              "args": {
                "runId": {
                  "$input": "runId"
                }
              },
              "check": "completed",
              "save": "run"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [
        {
          "failure": "Interrupted effect or verifier failure",
          "recovery": "Inspect receipt and reconcile; never restart the same write as a new request."
        },
        {
          "failure": "Nesting start inside manual.run",
          "recovery": "Call autopilot.start directly through the owning gateway; the controller owns manual execution locks."
        }
      ],
      "frontier": [
        "Automatic execution currently supports local observations and saved-source CAS text edits; external/irreversible actions require separate approval.",
        "Quarantined mapping patches are proposed by exploration, never promoted by autopilot."
      ],
      "guidance": [
        "Start with exact scopeTools; scope restricts caller authority and grants nothing.",
        "Luna selects manual procedures and decides explicit JUDGE points; explicit gpt-6.1-sol handles disagreement/frontier.",
        "Compiled scripts are reused only for current hashes and identical learned inputs; changed guards return to JUDGE.",
        "Background runs belong to owner HTTP POST /api/ui/autopilot; tool starts run synchronously.",
        "Same requestId retries return retained state. Stop is cooperative at the next action; poll get/list for proof.",
        "Choose only IDs from the current scoped catalog. The host resolves unique normalized aliases, close spelling and exact chapter/procedure ownership, records corrections, and retries one unresolvable selection before effects. Ambiguous or absent routes require a new grounded choice; scope, CAS and acceptance checks still apply."
      ]
    },
    "proofs-e-models": {
      "title": "PROOFS-e: production model contracts",
      "state": {
        "receipt": {
          "args": {},
          "inputs": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "shape": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              }
            },
            "required": [
              "ok"
            ]
          },
          "tool": "neyvia.verify.status"
        }
      },
      "actions": {
        "status": {
          "effect": "Read the most recent verification receipt without invoking production actions again",
          "pre": "Selected local workspace; read only",
          "returns": {
            "type": "object",
            "required": [
              "ok",
              "available",
              "complete"
            ]
          },
          "reversible": true,
          "schema": "proofs-e-models.status",
          "tool": "neyvia.verify.status"
        }
      },
      "checks": {
        "observed": {
          "args": {},
          "expect": {
            "op": "eq",
            "path": "ok",
            "value": true
          },
          "tool": "neyvia.verify.status"
        }
      },
      "procedures": {
        "read-model-proof-receipt": {
          "goal": "Read the latest receipt after the production model self-check runner",
          "inputs": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "steps": [
            {
              "action": "status",
              "args": {},
              "check": "observed",
              "save": "receipt"
            }
          ]
        }
      },
      "judge": {},
      "pitfalls": [
        {
          "failure": "Model transforms are reported as proof of a native app/provider/device effect",
          "recovery": "Use the real owning feature procedure and its observed runtime"
        }
      ],
      "frontier": [
        "Rendered browser/desktop journeys are separate from pure model proof",
        "Remote device, game editor and provider behavior require their real runtimes"
      ],
      "guidance": [
        "autopilot.scopeTools: Unknown scopes are read-only; edit adds only workspace.write",
        "autopilot.scopeOf: Only a named CAS workspace.write grants edit scope",
        "autopilot.attributeCalls: Every observed model call stays visible once, with its measured tokens, and judgement/frontier calls follow item order",
        "autopilot.shapeRun: Item routes preserve receipts; completed manual/script counts and total tokens come only from durable observations",
        "autopilot.checkLine: Final verification text names the real tool, target, observed path and exact operation/value",
        "Startup runner: scripts/proofs-e-models.mjs --root <owned-scratch>; area proofs-e-models checks real model actions and corrupted output refusals"
      ]
    }
  }
