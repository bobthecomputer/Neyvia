          "reversible": true,
          "schema": "neyvia.settings.get",
          "tool": "neyvia.settings.get"
        },
        "propose": {
          "effect": "Queue an exact owner approval; no preference changes yet",
          "pre": "Use the observed revision; owner decides each proposal",
