            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.settings.propose",
          "tool": "neyvia.settings.propose"
        },
        "setup": {
          "effect": "Emit setup.open resume=true without deleting installed state",
          "pre": "Owner requests setup re-entry",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.settings.setup",
          "tool": "neyvia.settings.setup"
        },
        "network_check": {
          "effect": "Attempt nine forbidden operations and report actual policy refusals",
          "pre": "Local-only must already be enabled",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.settings.network_check",
          "tool": "neyvia.settings.network_check"
        },
        "settings.get": {
          "effect": "Observe canonical settings revision, policy and setup state",
          "pre": "Workspace state root is available",
          "returns": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer"
              }
            },
            "required": [
              "revision"
            ]
          },
          "reversible": true,
          "schema": "neyvia.settings.get",
          "tool": "neyvia.settings.get"
        },
        "settings.setup": {
          "effect": "Persist setup.requestedAt and emit setup.open without erasing installation",
          "pre": "Workspace state root is available",
          "returns": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "setup": {
                "type": "object"
              }
            },
            "required": [
              "ok",
              "setup"
            ]
          },
          "reversible": true,
          "schema": "neyvia.settings.setup",
          "tool": "neyvia.settings.setup"
        },
        "settings.propose": {
          "effect": "Save an exact patch approval request; repeat approved proposal returns its durable receipt",
          "pre": "Known valid patch and current expectedRevision; owner approval remains required",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.settings.propose",
          "tool": "neyvia.settings.propose"
        }
      },
      "checks": {
        "enforced": {
          "args": {},
          "expect": {
            "op": "eq",
            "path": "network.enforced",
            "value": true
