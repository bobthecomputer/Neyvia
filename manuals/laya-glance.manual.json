            "record": false,
            "scene": {
              "nodes": [
                {
                  "attributes": {
                    "symbol": "BTC-USD"
                  },
                  "id": "book",
                  "kind": "position",
                  "measurements": {
                    "exposure": 0.31,
                    "limit": 0.25
                  }
                },
                {
                  "attributes": {
                    "note": "__import__('os').system('calc')"
                  },
                  "id": "feed",
                  "kind": "quote",
                  "measurements": {
                    "ageSeconds": 2
                  }
                }
              ]
            }
          },
          "expect": {
            "op": "schema",
            "path": "findings",
            "schema": {
