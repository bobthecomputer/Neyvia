  "chapters": {
    "scene": {
      "title": "One Scene core: transcribe, predicates, instant examples and guarded improvement",
      "state": {},
      "actions": {
        "scene-transcribe": {
          "effect": "Transcribe one domain source through its registered adapter into a shared CL Scene.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.scene.transcribe",
          "tool": "neyvia.scene.transcribe"
        },
        "scene-vocabulary": {
          "effect": "Read the registered domain predicates and named fix patterns.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.scene.vocabulary",
          "tool": "neyvia.scene.vocabulary"
        },
        "laya-judge": {
          "effect": "Apply one shared predicate evaluator and instant episodic admission to a Scene. Out-of-repo callers may pass a raw scene with its domain and their own predicates (same shape, data only, never executed).",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.laya.judge",
          "tool": "neyvia.laya.judge"
        },
        "scene-improve": {
          "effect": "Apply only explicitly budgeted reversible adapter fixes; trading is human review only.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.scene.improve",
          "tool": "neyvia.scene.improve"
        },
        "scene-episode": {
          "effect": "Write a labelled Scene episode immediately without training.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.scene.episode",
          "tool": "neyvia.scene.episode"
        },
        "laya-glance_contracts": {
          "effect": "Observe real headless DOM/canvas cases for the CL scene predicates.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.laya.glance_contracts",
          "tool": "neyvia.laya.glance_contracts"
        },
        "laya-glance": {
          "effect": "Apply the CL broken-UI vocabulary to a perception scene or immutable handle. Unknown facts request one model look.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.laya.glance",
          "tool": "neyvia.laya.glance"
        },
        "laya-glance_proof": {
          "effect": "Glance the recorded before/after fix captures from pixels alone: black PDF page, see-through panels, clipped composer chips.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": true,
          "schema": "neyvia.laya.glance_proof",
          "tool": "neyvia.laya.glance_proof"
        },
        "laya-glance_lesson": {
          "effect": "Teach one node instantly: broken adds the defect to similar text, fine suppresses a false alarm. No training.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.laya.glance_lesson",
          "tool": "neyvia.laya.glance_lesson"
        },
        "laya-glance_learn": {
          "effect": "Write one labelled screenshot episode; no training or head consolidation.",
          "pre": "Registered adapter; source is observed data; mutations need caller authority",
          "returns": {
            "type": "object"
          },
          "reversible": false,
          "schema": "neyvia.laya.glance_learn",
          "tool": "neyvia.laya.glance_learn"
        }
      },
