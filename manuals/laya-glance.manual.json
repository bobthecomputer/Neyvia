                  },
                  "predicate": {
                    "const": "risk-limit-breach"
                  }
                },
                "required": [
                  "predicate",
                  "node"
                ],
                "type": "object"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            }
