        "includeDeleted": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": []
    },
    "neyvia.comments.resolve": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id"
      ]
    },
    "neyvia.comments.send": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
