      "judge": {},
      "pitfalls": [
        {
          "failure": "A stale revision or an unavailable destination rejects a request",
          "recovery": "Refresh comments and inspect the session; preserve open comments and choose an available exact destination"
        },
        {
          "failure": "A send request is pending after interruption",
          "recovery": "Inspect the session before a new requestId; do not blindly replay an uncertain delivery"
        }
      ],
      "frontier": [
        "Backend records do not prove rendered pins or screenshot crops; the UI owns that evidence.",
        "A send receipt proves acceptance by the connected runtime, not completion of the requested edit. Resolve only after verifying the target."
      ],
      "guidance": [
        "Stable target strings select the shared workspace view. Target and anchor JSON are data; reread the actual subject.",
        "Delete appends a tombstone; all events and deliveries remain in comments.sqlite3."
