{
  "schema": "neyvia.manual.v1",
  "id": "comments",
  "kind": "environment",
  "proofs": {
    "area": "comments",
    "contracts": [
      {
        "checkedAt": [
          "neyvia_comments.Store append-only SQLite triggers and rows",
          "cl.comments_effects.verify fresh store observation"
        ],
        "claim": "Comment edits, tombstones and delivery state are immutable events; current rows derive from their latest event.",
        "id": "comments.append-only",
        "impact": [
          "workspace comments",
          "restart persistence"
        ],
        "phase": "invariant"
      },
      {
        "checkedAt": [
          "neyvia_comments.send/deliver",
          "cl.comments_effects.verify"
        ],
        "claim": "A sent message has a real connected-session acceptance and a durable receipt; failures and uncertain retries never claim success.",
        "id": "comments.send",
        "impact": [
          "session delivery",
          "comment resolution"
        ],
        "phase": "post"
      }
    ]
  },
  "schemas": {
    "neyvia.comments.add": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
