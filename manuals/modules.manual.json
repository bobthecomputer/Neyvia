{
  "schema": "neyvia.manual.v1",
  "id": "modules",
  "kind": "environment",
  "proofs": {
    "area": "path-policy-outcomes, python-sdk-journey",
    "manifests": [
      "config/proofs/path-policy-outcomes.json",
      "config/proofs/python-sdk-journey.json"
    ],
    "contracts": [
      {
        "id": "p22.path-policy-outcomes",
        "phase": "post",
        "claim": "A real Git diff leaves deleted paths exempt, requires file-level evidence for surviving files with removed lines and binary changes, preserves changed-line locations for Unicode and spaced paths across bounded large pathspec batches, and classifies generated output, third-party trees and CI workflow configuration by policy.",
        "checkedAt": [
          "grant_agent.contract_diff.changed_lines",
          "grant_agent.contract_diff._line_inventories",
          "grant_agent.contract_coverage.classify",
          "grant_agent.contract_coverage.model",
          "grant_agent.contract_measurements.admission",
          "grant_agent.proofs_path_policy_outcomes.path_policy_classification"
        ],
        "impact": [
          "Path policy and measured changed-line admission"
        ]
      },
      {
        "id": "p22.python-sdk-http-boundary",
        "phase": "post",
        "claim": "The Python SDK maps an HTTP 400 service refusal to NeyviaError with the original status, code, message, and request command.",
        "checkedAt": [
          "src/neyvia_sdk/client.py",
          "grant_agent.proofs_python_sdk_journey.self_check"
        ],
        "impact": [
          "Python SDK HTTP 400 refusal mapping"
        ]
      }
    ]
  },
