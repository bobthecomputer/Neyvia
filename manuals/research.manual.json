{
  "schema": "neyvia.manual.v1",
  "id": "research",
  "kind": "workflow",
  "proofs": {
    "area": "research-journey",
    "contracts": [
      {
        "id": "p22.research-workspace-search",
        "phase": "post",
        "claim": "A local research query returns its exact Unicode source line and path as evidence; an escaping search scope is refused without changing the source.",
        "checkedAt": [
          "grant_agent.research.search_workspace_detailed",
          "grant_agent.proofs_research_journey.local_workspace_search"
        ],
        "impact": [
          "Local workspace research evidence and source citations",
          "Research search scope refusal"
        ]
      }
    ]
  },
  "schemas": {
    "neyvia.workflow.check": {
      "type": "object",
      "properties": {
        "manual": {
          "type": "string",
          "enum": [
            "hill-climb",
            "creativity",
            "critique-review",
            "efficiency",
            "research",
            "design"
          ]
        },
        "report": {
          "type": "object"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "outcomeQuality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "manual",
        "report",
        "evidence",
        "outcomeQuality",
        "tokens"
      ]
    },
    "neyvia.workflow.record": {
      "type": "object",
      "properties": {
        "manual": {
          "type": "string",
          "enum": [
            "hill-climb",
            "creativity",
            "critique-review",
            "efficiency",
            "research",
            "design"
          ]
        },
        "report": {
          "type": "object"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "outcomeQuality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "manual",
        "report",
        "evidence",
        "outcomeQuality",
        "tokens"
      ]
    }
  },
  "chapters": {
    "workflow": {
      "title": "Executable research method: chronological mechanism and measured quality",
      "state": {
        "adherence": {
          "args": {
            "evidence": {
              "$input": "evidence"
            },
            "manual": "research",
            "outcomeQuality": {
              "$input": "outcomeQuality"
            },
            "report": {
              "$input": "report"
            },
            "tokens": {
              "$input": "tokens"
            }
          },
          "inputs": {
            "type": "object",
            "properties": {
              "report": {
                "type": "object"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "outcomeQuality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "report",
              "evidence",
              "outcomeQuality",
              "tokens"
            ]
          },
          "shape": {
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "adherence": {
                "type": "number"
              },
              "fitness": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "accepted",
              "adherence",
              "fitness",
              "errors"
            ],
            "additionalProperties": true
          },
          "tool": "neyvia.workflow.check"
        }
      },
      "actions": {
        "check": {
          "effect": "Validate ordered workflow evidence",
          "pre": "Host owns task measurements and provider usage; report is bounded JSON",
          "returns": {
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "adherence": {
                "type": "number"
              },
              "fitness": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "accepted",
              "adherence",
              "fitness",
              "errors"
            ],
            "additionalProperties": true
          },
          "reversible": true,
          "schema": "neyvia.workflow.check",
          "tool": "neyvia.workflow.check"
        },
        "record": {
          "effect": "Persist a validated workflow receipt under the selected task root",
          "pre": "Host owns task measurements and provider usage; report is bounded JSON",
          "returns": {
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "adherence": {
                "type": "number"
              },
              "fitness": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "accepted",
              "adherence",
              "fitness",
              "errors"
            ],
            "additionalProperties": true
          },
          "reversible": false,
          "schema": "neyvia.workflow.record",
          "tool": "neyvia.workflow.record"
        }
      },
      "checks": {
        "adhered": {
          "args": {
            "evidence": {
              "$input": "evidence"
            },
            "manual": "research",
            "outcomeQuality": {
              "$input": "outcomeQuality"
            },
            "report": {
              "$input": "report"
            },
            "tokens": {
              "$input": "tokens"
            }
          },
          "expect": {
            "op": "eq",
            "path": "accepted",
            "value": true
          },
          "tool": "neyvia.workflow.check"
        }
      },
      "procedures": {
        "verify-and-record": {
          "goal": "Verify defining workflow mechanism against host evidence and persist the acceptance receipt",
          "inputs": {
            "type": "object",
            "properties": {
              "report": {
                "type": "object"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "outcomeQuality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "report",
              "evidence",
              "outcomeQuality",
              "tokens"
            ]
          },
          "steps": [
            {
              "action": "check",
              "args": {
                "evidence": {
                  "$input": "evidence"
                },
                "manual": "research",
                "outcomeQuality": {
                  "$input": "outcomeQuality"
                },
                "report": {
                  "$input": "report"
                },
                "tokens": {
                  "$input": "tokens"
                }
              },
              "check": "adhered",
              "save": "verified"
            },
            {
              "action": "record",
              "args": {
                "evidence": {
                  "$input": "evidence"
                },
                "manual": "research",
                "outcomeQuality": {
                  "$input": "outcomeQuality"
                },
                "report": {
                  "$input": "report"
                },
                "tokens": {
                  "$input": "tokens"
                }
              },
              "check": "adhered",
              "save": "recorded"
            }
          ]
        }
      },
      "judge": {
        "quality": {
          "constraints": "Use an independent frozen host quality judge; self-reported quality is not evidence.",
          "options": [
            "accept",
            "revise"
          ],
          "question": "Does the outcome satisfy the actual task, beyond recorded adherence?"
        }
      },
      "pitfalls": [
        {
          "failure": "A model writes its own successful receipt, outcome score or token count",
          "recovery": "The host supplies hash-bound local evidence files, independently judged quality and provider usage; invented IDs fail"
        }
      ],
      "frontier": [
        "Executable adherence is necessary but not sufficient for semantic quality. Outcome quality belongs to a separate frozen task judge.",
        "Three paired tasks provide bounded evidence and cannot authorize statistical Evolver promotion."
      ],
      "guidance": [
        "Start with one question that could change the implementation decision. Compare at least two concrete prior-art sources and what each establishes.",
        "State a prediction and a falsifier before testing. Prefer the smallest real test that discriminates the alternatives.",
        "The result must agree with measured success/failure, state limitations and separate observed facts from inference. A negative result is useful evidence.",
        "Report shape: {events:[{stage,data}],result:object}. Required chronological stages: question, prior-art, claim, test, result",
        "question{question}; prior-art{sources:[{source,finding}]>=2}; claim{prediction,falsifier}; test{receipt}; result{supported:boolean,limitations:[strings]}. Test evidence has success:boolean.",
        "Public tool evidence is {ID:{path:task-root-relative receipt JSON,sha256:receipt SHA256}}. Pure host evaluator evidence maps IDs to loaded measurements. Public tool outcome quality is explicitly caller-scored, never automatically verified.",
        "Every data.receipt is a STRING naming a key in the host evidence mapping: for example {\"receipt\":\"measurement\"}. Never copy the receipt object or create a new ID. Public tool callers pass path/SHA descriptors separately; event receipt fields remain string IDs. Use the exact keys the current task supplied, not the example keys below.",
        "Conforming shape example (replace illustrative values, IDs and decision with the actual task/evidence; do not copy its outcome): {\"events\":[{\"stage\":\"question\",\"data\":{\"question\":\"does the candidate fix the observed failure\"}},{\"stage\":\"prior-art\",\"data\":{\"sources\":[{\"source\":\"owner source file\",\"finding\":\"defining mechanism implemented here\"},{\"source\":\"actual run receipt\",\"finding\":\"records the observed failure boundary\"}]}},{\"stage\":\"claim\",\"data\":{\"prediction\":\"candidate passes the frozen check\",\"falsifier\":\"same check fails on the candidate\"}},{\"stage\":\"test\",\"data\":{\"receipt\":\"test\"}},{\"stage\":\"result\",\"data\":{\"supported\":false,\"limitations\":[\"single task does not prove generality\"]}}],\"result\":{\"decision\":\"task-specific actual answer\"}}"
      ]
    }
  }
}
