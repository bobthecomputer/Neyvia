{
  "id": "/control",
  "name": "Neyvia",
  "short_name": "Neyvia",
  "description": "Private agent control for your computer and NAS.",
  "start_url": "/control",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0a0f0c",
  "theme_color": "#0a0f0c",
  "orientation": "any",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    { "src": "/icons/neyvia-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/neyvia-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/neyvia-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Neyvia Agent",
      "short_name": "Agent",
      "description": "Open the same Neyvia Agent workspace on your phone.",
      "url": "/control?surface=agent",
      "icons": [{ "src": "/icons/neyvia-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Phone status",
      "short_name": "Status",
      "description": "Check the connected computer and NAS.",
      "url": "/control?surface=phone&phoneView=status",
      "icons": [{ "src": "/icons/neyvia-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Image workspace",
      "short_name": "Images",
      "description": "Generate and reuse project images.",
      "url": "/control?surface=images",
      "icons": [{ "src": "/icons/neyvia-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
