+/// True only when every box in an opacity group, including shadow and outline
+/// ink, is more than `OPACITY_CULL_MARGIN` CSS pixels outside the paint
+/// surface. Anything uncertain (an authored transform in the subtree, which
+/// can move ink anywhere) keeps the group.
+const OPACITY_CULL_MARGIN: f32 = 192.0;
+
+fn opacity_group_is_far_offscreen(
+    tree: &DomTree,
+    laid: &crate::DomLayout,
+    scroll_state: &ScrollPaintState<'_>,
+    root: obscura_dom::tree::NodeId,
+    pixmap: &Pixmap,
+    raster_scale: f32,
+) -> bool {
+    let nodes: Vec<_> = std::iter::once(root)
+        .chain(crate::dom::rendered_descendants(tree, root))
+        .collect();
+    if nodes.iter().any(|id| {
+        laid.styles
+            .get(id)
+            .is_some_and(|style| has_authored_transform(style))
+    }) {
+        return false;
+    }
+    let Some(bounds) = transform_subtree_source_bounds(tree, laid, scroll_state, root) else {
+        return false;
+    };
+    let surface = paint_surface_rect(pixmap, raster_scale);
+    let guarded = crate::Rect {
+        x: surface.x - OPACITY_CULL_MARGIN,
+        y: surface.y - OPACITY_CULL_MARGIN,
+        width: surface.width + 2.0 * OPACITY_CULL_MARGIN,
+        height: surface.height + 2.0 * OPACITY_CULL_MARGIN,
+    };
+    bounds.intersect(&guarded).is_none()
+}
