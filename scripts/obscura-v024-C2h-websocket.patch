+# Client transport for the page `WebSocket` API. rustls with webpki roots
+# reuses the ring-backed rustls reqwest already links, so wss:// adds no new
+# TLS stack.
+tokio-tungstenite = { workspace = true, features = ["rustls-tls-webpki-roots"] }
+futures-util = { version = "0.3", default-features = false, features = ["sink"] }
