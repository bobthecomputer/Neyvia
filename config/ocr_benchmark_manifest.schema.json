{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neyvia.ocr_benchmark_manifest.v2",
  "title": "Neyvia deterministic OCR benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmarkId", "models", "cases", "observations"],
  "properties": {
    "schema": {"const": "neyvia.ocr_benchmark_manifest.v2"},
    "benchmarkId": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "claim"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "availability", "identity", "quantization", "cache"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "availability": {"enum": ["installed", "missing-model", "unproven"]},
        "engineIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "revision": {"type": ["string", "null"]},
            "digest": {"type": ["string", "null"]},
            "weightsSha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "registry": {"$ref": "#/$defs/identityAnchor"},
            "toolLock": {"$ref": "#/$defs/toolLockAnchor"}
          }
        },
        "quantization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "precision", "provenance"],
          "properties": {
            "format": {"type": ["string", "null"]},
            "precision": {"type": ["string", "null"]},
            "provenance": {"type": "string", "minLength": 1}
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "provenance"],
          "properties": {
            "state": {"enum": ["present", "missing", "unproven"]},
            "treeSha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "provenance": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "source", "tags"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages", "layout", "content", "handwriting"],
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "layout": {
              "type": "array",
              "items": {
                "enum": ["single-column", "multi-column", "structured", "photographed", "distorted"]
              }
            },
            "content": {
              "type": "array",
              "items": {"enum": ["printed-text", "table", "math", "handwriting"]}
            },
            "handwriting": {"type": "boolean"}
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "caseId", "state"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "caseId": {"type": "string", "minLength": 1},
        "state": {"enum": ["measured", "unproven", "missing-model"]},
        "reason": {"type": "string"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "hypothesis"],
          "properties": {
            "reference": {"$ref": "#/$defs/binding"},
            "hypothesis": {"$ref": "#/$defs/binding"}
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectedEngine", "automatic", "reason", "signals"],
          "properties": {
            "selectedEngine": {"type": "string", "minLength": 1},
            "automatic": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1},
            "signals": {"type": "object"}
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "cacheMode", "measurementProvenance"],
          "properties": {
            "startupMs": {"type": ["number", "null"], "minimum": 0},
            "latencyMs": {"type": ["number", "null"], "minimum": 0},
            "peakMemoryMb": {"type": ["number", "null"], "minimum": 0},
            "pagesPerSecond": {"type": ["number", "null"], "minimum": 0},
            "temperature": {"const": 0},
            "cacheMode": {"enum": ["cold", "warm", "unknown"]},
            "measurementProvenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["classification", "source", "method", "collector", "evidence"],
              "properties": {
                "classification": {"const": "self-declared"},
                "source": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1},
                "collector": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "version": {"type": "string", "minLength": 1}
                  }
                },
                "evidence": {"$ref": "#/$defs/binding"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "measured"}}},
          "then": {"required": ["artifacts", "route", "performance"]},
          "else": {"required": ["reason"]}
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "identityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonicalSha256", "entrySha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "canonicalSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "entrySha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "toolLockAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonicalSha256", "entrySha256", "toolId"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "canonicalSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "entrySha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "toolId": {"type": "string", "minLength": 1}
      }
    }
  }
}
