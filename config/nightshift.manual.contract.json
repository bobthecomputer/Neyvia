      "actions": {
        "nightshift.tasks": {
          "tool": "neyvia.nightshift.tasks",
          "schema": "neyvia.nightshift.tasks",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Read the saved task graph, evidence and launch reasons.",
          "reversible": true
        },
        "nightshift.create": {
          "tool": "neyvia.nightshift.create",
          "schema": "neyvia.nightshift.create",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Store a dormant task; needs are task IDs. Nothing runs until explicitly started.",
          "reversible": true
        },
        "nightshift.import": {
          "tool": "neyvia.nightshift.import",
          "schema": "neyvia.nightshift.import",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Import TASKS.md dormant; source checkboxes do not count as execution evidence.",
          "reversible": true
        },
        "nightshift.tick": {
          "tool": "neyvia.nightshift.tick",
          "schema": "neyvia.nightshift.tick",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Complete a task with checked file, commit or its own completed run evidence; releases armed dependents.",
          "reversible": false
        },
        "nightshift.start": {
          "tool": "neyvia.nightshift.start",
          "schema": "neyvia.nightshift.start",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
