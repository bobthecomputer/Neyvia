        },
        "nightshift.begin": {
          "tool": "neyvia.nightshift.begin",
          "schema": "neyvia.nightshift.begin",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
