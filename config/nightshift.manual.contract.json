          "schema": "neyvia.nightshift.stop",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Stop an owned task; active repository lock stays until terminal harness state.",
          "reversible": true
        },
        "nightshift.block": {
          "tool": "neyvia.nightshift.block",
          "schema": "neyvia.nightshift.block",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
