          "tool": "neyvia.nightshift.summary",
          "schema": "neyvia.nightshift.summary",
          "returns": {
            "type": "object"
          },
          "pre": "Owner-approved scope; explicit prompts, prerequisites and saved resource policy",
          "effect": "Read morning evidence, blockers, waiting on Paul, measured time and token coverage.",
