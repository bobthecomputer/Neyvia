{
  "area": "d-host",
  "module": "grant_agent.proofs_d_host",
  "self_check": "self_check",
  "manuals": [
    "host-runtime"
  ],
  "contracts": [
    {
      "id": "d.host.event-identity",
      "phase": "post",
      "claim": "Detail and delta preserve caller identities or derive the same canonical 24-hex event identity.",
      "checkedAt": [
        "web_backend_workspace.decorate_mission_events -> proofs_d_host.check_event_identity"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.skill-provenance",
      "phase": "pre",
      "claim": "The canonical design/verification skill catalog retains required entries and real capability provenance.",
      "checkedAt": [
        "skills.SkillRegistry._load -> proofs_d_host.check_skill_catalog"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.remote-transport",
      "phase": "pre",
      "claim": "Remote transports admit only numeric authorized addresses without URL credentials, path, query or fragment; loopback needs explicit granted proof ports and mode.",
      "checkedAt": [
        "neyvia_remote._url/_proof_ports"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.stage-receipt",
      "phase": "post",
      "claim": "Compiled stage order and plan hash match durable receipts; regressed repairs keep rollback evidence and never claim rolled-back steps complete.",
      "checkedAt": [
        "neyvia_stage_scheduler.NeyviaStageScheduler.execute -> proofs_d_host.check_stage_receipt"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.stage-refusal",
      "phase": "pre",
      "claim": "Unknown executable actions return no_handler and never report success.",
      "checkedAt": [
        "neyvia_stage_scheduler.default_step_handler"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.delta-merge",
      "phase": "post",
      "claim": "Typed delta items merge deterministically by identity with later entries winning and evidence preserved.",
      "checkedAt": [
        "agent_delta.merge_agent_deltas -> proofs_d_host.check_delta_merge"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.delta-synthesis",
      "phase": "post",
      "claim": "Synthesis reads typed deltas, keeps transcripts excluded, computes blocker/conflict status and leaves unproven competing candidates disabled.",
      "checkedAt": [
        "agent_delta.synthesize_agent_deltas -> proofs_d_host.check_synthesis"
      ],
      "impact": [
        "mission receipts",
        "native execution",
        "operator authority"
      ]
    },
    {
      "id": "d.host.stage-tool-authority",
      "phase": "invariant",
      "claim": "Read tools dispatch through the progressive surface; mutating tools require explicit approval before the effect.",
      "checkedAt": [
        "neyvia_stage_scheduler.build_progressive_step_handler"
      ],
      "impact": [
        "scheduled tools",
        "approval",
        "deterministic receipts"
      ]
    },
    {
      "id": "d.host.stage-parallel",
      "phase": "invariant",
      "claim": "Independent parallel-safe stages use worker futures and merge the resulting outcomes in compiled order.",
      "checkedAt": [
        "neyvia_stage_scheduler.NeyviaStageScheduler._run_parallel_steps/execute -> proofs_d_host.check_stage_receipt"
      ],
      "impact": [
        "scheduled tools",
        "approval",
        "deterministic receipts"
      ]
    },
    {
      "id": "d.host.selected-context",
      "phase": "post",
      "claim": "Selected context preserves bounded source/import lineage and canonical content hashes, including empty selections.",
      "checkedAt": [
        "neyvia_runtime_invocation.build_selected_context_packet -> proofs_d_host.check_context_packet"
      ],
      "impact": [
        "delegated runtime context",
        "receipt provenance"
      ]
    },
    {
      "id": "d.host.nearby-redaction",
      "phase": "post",
      "claim": "Every public transfer receipt/progress projection excludes transport capabilities and absolute sources, caps files/chunks and discloses truncation.",
      "checkedAt": [
        "nearby_send.NearbySendService._public_receipt/_public_progress -> proofs_d_host.check_nearby_projection"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.nearby-recovery",
      "phase": "post",
      "claim": "Under the state lock, a dead owner becomes interrupted without retaining transfer claims or secrets; corrupt state yields an inactive empty projection.",
      "checkedAt": [
        "nearby_send.NearbySendService.get_active_transfer -> proofs_d_host.check_nearby_state"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.nearby-history",
      "phase": "post",
      "claim": "History is bounded by caller and server limits, skips corrupt receipts and reports accurate returned-state counts.",
      "checkedAt": [
        "nearby_send.NearbySendService.list_transfer_history -> proofs_d_host.check_nearby_history"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.policy-owner",
      "phase": "invariant",
      "claim": "Settings owners register their selected state root, release independently and reopen the persisted local-only preference.",
      "checkedAt": [
        "local_network_policy.install/release/enabled -> proofs_d_host.check_policy_release"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.policy-root",
      "phase": "invariant",
      "claim": "Missing policy roots retire after a locked recheck; existing state directories stay observed and Settings re-registers its owner.",
      "checkedAt": [
        "local_network_policy.enabled/install"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.policy-startup",
      "phase": "pre",
      "claim": "Pending child startup permits socket workers but refuses local-only activation; enabled local-only mode refuses native terminal launch before loading its launcher.",
      "checkedAt": [
        "local_network_policy.child_start/transition; src/grant_agent/connected_sessions/claude_terminal.py:spawn_terminal"
      ],
      "impact": [
        "transfer receipts",
        "scoped local network authority",
        "Settings lifetime"
      ]
    },
    {
      "id": "d.host.artifact-serving",
      "phase": "post",
      "claim": "Only paths accepted by the artifact gate gain safe 24-hex serving URLs/media types; rejected paths lose stale artifact endpoints.",
      "checkedAt": [
        "web_backend_workspace.WorkspaceArtifactMixin._decorate_mission_artifacts -> proofs_d_host.check_artifact_row"
      ],
      "impact": [
        "mission artifacts",
        "authenticated content serving"
      ]
    }
  ],
