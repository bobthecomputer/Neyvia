        "neyvia_onboarding.run_download -> proofs_d_onboarding.check_manifest/safe_destination",
        "neyvia_onboarding._safe_relative/_check_source",
        "proofs_d_onboarding.self_check"
      ],
      "case_id": "tests/test_neyvia_onboarding.py::DownloaderTests.test_manifest_rejects_unsafe_paths_and_sources"
    },
    {
      "test": "tests/test_neyvia_onboarding.py",
      "case": "DownloaderTests.test_bundled_test_manifest_is_valid",
      "contracts": [
