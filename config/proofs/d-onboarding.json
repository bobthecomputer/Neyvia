      ],
      "checkedAt": [
        "neyvia_onboarding.parse_manifest -> proofs_d_onboarding.check_manifest",
        "neyvia_onboarding.run_download -> proofs_d_onboarding.check_manifest/safe_destination",
        "neyvia_onboarding._safe_relative/_check_source",
        "proofs_d_onboarding.self_check"
      ],
      "case_id": "tests/test_neyvia_onboarding.py::DownloaderTests.test_bundled_test_manifest_is_valid"
    },
    {
      "test": "tests/test_neyvia_onboarding.py",
      "case": "DownloaderTests.test_add_on_worker_installs_local_manifest_on_separate_state",
      "contracts": [
        "onboarding.addon-isolation",
        "onboarding.verified-staging"
      ],
      "checkedAt": [
        "neyvia_onboarding.pack_status -> neyvia_onboarding._installed_pack_error",
        "neyvia_onboarding.pack_status -> proofs_d_onboarding.check_pack_status",
        "neyvia_onboarding.install_pack -> neyvia_onboarding._spawn_worker",
        "proofs_d_onboarding.self_check",
        "neyvia_onboarding.run_download -> proofs_d_onboarding.check_staged_file/check_download_result",
        "neyvia_onboarding._fetch",
        "neyvia_onboarding.install_pack/run_download -> proofs_d_onboarding.check_staging_scope"
      ],
      "case_id": "tests/test_neyvia_onboarding.py::DownloaderTests.test_add_on_worker_installs_local_manifest_on_separate_state"
    },
    {
