    {
      "id": "proofs-c.missions.receipt-schema",
      "phase": "invariant",
      "claim": "Receipts use known schemas, producer phases, parseable timestamps, required fields and verification decisions; invalid input is rejected before append.",
      "checkedAt": [
        "mission_receipts.validate_mission_receipt -> proofs_c_missions.check_receipt",
        "proofs_c_missions.self_check"
      ],
      "impact": [
        "mission handoff",
        "durable receipts",
        "operator status"
      ]
    },
    {
      "id": "proofs-c.missions.receipt-durable",
      "phase": "invariant",
      "claim": "Locked appends persist the exact serialized stream tail, preserve concurrent receipts and bound retention; invalid input creates no stream.",
      "checkedAt": [
        "mission_receipts.append_mission_receipt -> proofs_c_missions.check_receipt_write (inside file lock)",
        "proofs_c_missions.self_check"
      ],
      "impact": [
        "mission handoff",
        "durable receipts",
        "operator status"
      ]
    },
    {
      "id": "proofs-c.missions.receipt-filter",
      "phase": "invariant",
      "claim": "Receipt reads skip malformed rows, filter by mission before limiting and preserve durable stream order.",
      "checkedAt": [
        "mission_receipts.load_mission_receipts -> proofs_c_missions.check_receipt_read",
        "proofs_c_missions.self_check"
      ],
      "impact": [
        "mission handoff",
        "durable receipts",
        "operator status"
      ]
    },
    {
