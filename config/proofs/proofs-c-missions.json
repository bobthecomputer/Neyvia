        "mission_receipts.validate_mission_receipt / mission_phase_runner -> proofs_c_missions.check_default_factories",
        "proofs_c_missions.self_check"
      ],
      "impact": [
        "mission handoff",
        "durable receipts",
        "operator status"
      ]
    },
    {
