  "contracts": [
    {
      "id": "desktop.debugger.bundle",
      "phase": "post",
      "claim": "Returned debugger manifest equals durable state; copied evidence bytes match source, missing evidence is explicit, snapshots are compact, and every bundle includes a next action.",
      "checkedAt": [
        "grant_agent.debugger_bundle.write_debugger_bundle",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "diagnostic artifacts",
        "debugger manifest"
      ]
    },
    {
      "id": "desktop.debugger.summary",
      "phase": "post",
      "claim": "Diagnostic summaries use the newest concrete failing receipt; absent evidence is insufficient_evidence with no invented failure or proof paths; proof links are unique and bounded.",
      "checkedAt": [
        "grant_agent.debugger_bundle.build_diagnostic_summary",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "operator failure diagnosis"
      ]
    },
    {
      "id": "desktop.docs.evidence",
      "phase": "post",
      "claim": "Every requested document receives a bounded successful observation or explicit error; docs_evidence.json equals the returned ordered observations.",
      "checkedAt": [
        "grant_agent.doc_ingestion.ingest_docs",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "document evidence",
        "session observer"
      ]
    },
    {
      "id": "desktop.gateway.heartbeat",
      "phase": "post",
      "claim": "A gateway heartbeat is durably recorded and agrees with the local accelerator registry capabilities, unlimited concurrency and workspace mapping.",
      "checkedAt": [
        "grant_agent.desktop_gateway.record_desktop_gateway_heartbeat",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "gateway availability",
        "cluster registry"
      ]
    },
    {
      "id": "desktop.gateway.route",
      "phase": "post",
      "claim": "Gateway routing preserves all required capabilities, selects a capable online PC, leaves ordinary work on the controller, and queues missing gateway work as a proof gap.",
      "checkedAt": [
        "grant_agent.desktop_gateway.route_gateway_job",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "job routing",
        "proof availability"
      ]
    },
    {
      "id": "desktop.gateway.reconcile",
      "phase": "post",
      "claim": "Lost gateway jobs are durably queued with a proof-gap explanation and cluster event rather than being declared failed.",
      "checkedAt": [
        "grant_agent.desktop_gateway.reconcile_disappeared_gateway_jobs",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "gateway job lifecycle",
        "recovery queue"
      ]
    },
    {
      "id": "desktop.gateway.event",
      "phase": "post",
      "claim": "Gateway evidence is written to the event journal and, for a job, mirrored into the cluster event history with unchanged payload.",
      "checkedAt": [
        "grant_agent.desktop_gateway.record_gateway_event",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "gateway event observers",
        "job evidence"
      ]
    },
    {
      "id": "desktop.demo.comparison",
      "phase": "post",
      "claim": "Scores, remaining work and verification-failure deltas derive from the supplied runs; improvement requires no negative delta in any dimension.",
      "checkedAt": [
        "grant_agent.demo_runner.compare_training",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "training comparison claims"
      ]
    },
    {
      "id": "desktop.demo.probe",
      "phase": "post",
      "claim": "The local deterministic pattern probe records attempts whose outcomes determine the exact count, resistance and threshold status; this is not a live model resilience claim.",
      "checkedAt": [
        "grant_agent.demo_runner.run_adversarial_probe",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "local pattern probe",
        "defensive benchmark report"
      ]
    },
    {
      "id": "desktop.demo.export",
      "phase": "post",
      "claim": "Exports preserve findings and before/after/comparison evidence; report, panel and manifest exist and raw probe prompts are replaced by redaction text with their original hashes and lengths.",
      "checkedAt": [
        "grant_agent.demo_runner.export_report_bundle",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "demo export bundle",
        "export payload confidentiality"
      ]
    },
    {
      "id": "desktop.dashboard.artifact",
      "phase": "post",
      "claim": "The generated dashboard contains parseable HTML navigation and embedded evidence rows identical to current valid proof bundles; corrupt bundles are skipped. Rendered interactions are a separate frontier.",
      "checkedAt": [
        "grant_agent.dashboard.write_proof_dashboard",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "generated dashboard artifact",
        "bundle evidence projection"
      ]
    },
    {
      "id": "delivery.append",
      "phase": "post",
      "claim": "Appending under an interprocess journal lease preserves retained prior rows and records exactly the new receipt, capped at 500 journal lines.",
      "checkedAt": [
        "grant_agent.delivery_receipt._append_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "delivery audit log",
        "overnight retention"
      ]
    },
    {
      "id": "delivery.update",
      "phase": "post",
      "claim": "Updating under the journal lease matches receipt identity, preserves unrelated and malformed rows, and appends delayed missing receipts within the retention cap.",
      "checkedAt": [
        "grant_agent.delivery_receipt._update_last_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "delivery identity",
        "late recovery",
        "unrelated progress audit"
      ]
    },
    {
      "id": "delivery.tail-update",
      "phase": "post",
      "claim": "The legacy tail update is serialized with all receipt mutators and preserves preceding retained rows; it does not promise identity-based replacement.",
      "checkedAt": [
        "grant_agent.delivery_receipt._update_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "legacy provider receipt audit"
      ]
    },
    {
      "id": "delivery.ack",
      "phase": "post",
      "claim": "Acknowledgement under the journal lease changes only eligible matching receipt status/time; terminal errors, unknown identifiers and corrupt rows stay unchanged.",
      "checkedAt": [
        "grant_agent.delivery_receipt.acknowledge_delivery_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "browser acknowledgements",
        "terminal transport errors"
      ]
    },
    {
      "id": "delivery.observe",
      "phase": "post",
      "claim": "Receipt observations under the journal lease skip unreadable rows, retain newest-last order, and filter a mission before applying the limit.",
      "checkedAt": [
        "grant_agent.delivery_receipt.load_receipts",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "browser polling",
        "mission delivery observer"
      ]
    },
    {
      "id": "delivery.browser",
      "phase": "post",
      "claim": "Local browser progress is recorded as delivered to control-room with unchanged event kind/message and no token in a delivery URL.",
      "checkedAt": [
        "grant_agent.delivery_receipt.record_browser_delivery_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "browser progress",
        "local delivery receipt"
      ]
    },
    {
      "id": "delivery.skipped",
      "phase": "post",
      "claim": "Disabled or unconfigured escalation persists an explicit skipped receipt and reason; this declaration does not claim real provider delivery.",
      "checkedAt": [
        "grant_agent.delivery_receipt.send_approval_escalation_receipt",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "approval audit",
        "configuration failures"
      ]
    },
    {
      "id": "delivery.message",
      "phase": "post",
      "claim": "Telegram HTML escapes all caller-controlled mission identity, body and note while retaining only the fixed approval/code markup.",
      "checkedAt": [
        "grant_agent.delivery_receipt._format_telegram_message",
        "grant_agent.proofs_b_desktop.check"
      ],
      "impact": [
        "notification text",
        "HTML control characters"
      ]
    },
    {
      "id": "desktop.bridge.allowlist",
      "phase": "pre",
      "claim": "Desktop commands outside the product allow-list are rejected before root resolution, policy installation, backend construction or forwarding.",
      "checkedAt": [
        "grant_agent.desktop_bridge.dispatch_desktop_command"
      ],
      "impact": [
        "desktop IPC authority"
      ]
    }
  ],
