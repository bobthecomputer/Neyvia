        "grant_agent.native_tools.NativeToolRegistry._workspace_write",
        "grant_agent.edge_journeys.run"
      ],
      "impact": [
        "workspace file writes",
        "rejected request filesystem effects"
      ]
    },
    {
      "id": "c7.gateway.read-only",
      "phase": "pre",
      "claim": "Read-only native gateway refuses file mutation without creating its target.",
      "checkedAt": [
        "grant_agent.neyvia_agent.NeyviaToolGateway.call_native",
        "grant_agent.edge_journeys.run"
      ],
      "impact": [
        "native mutation authority"
      ]
