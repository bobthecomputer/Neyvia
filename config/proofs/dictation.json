  "contracts": [
    {
      "id": "dictation.names.persisted",
      "phase": "post",
      "claim": "Name add/remove persists exactly the requested aliases and the names observer reports persisted plus built-in aliases.",
      "checkedAt": [
        "grant_agent.neyvia_dictation.names",
        "grant_agent.proofs_dictation.after"
