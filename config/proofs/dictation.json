        "other workspaces"
      ]
    },
    {
      "id": "dictation.prompt.structure",
      "phase": "post",
      "claim": "The prompt is assembled only from ordered text segments; preview is required and stable/provisional match finality. An unfinished hypothesis is literal and has no editor commands.",
      "checkedAt": [
        "grant_agent.neyvia_prompt_dictation.process_prompt",
        "grant_agent.neyvia_dictation.process",
        "grant_agent.proofs_dictation.check_prompt"
      ],
      "impact": [
        "composer preview",
        "Notes prompt",
        "desktop and HTTP dictation"
      ]
    },
    {
      "id": "dictation.prompt.commands",
      "phase": "post",
      "claim": "Known whole and terminal spoken commands become ordered command segments instead of prompt words; emitted commands equal the command segments. Quoted text remains literal in scratch procedures.",
      "checkedAt": [
        "grant_agent.neyvia_prompt_dictation.process_prompt",
        "grant_agent.proofs_dictation.check_prompt"
      ],
      "impact": [
        "editor spoken commands",
        "send preview"
      ]
    },
    {
      "id": "dictation.prompt.route",
      "phase": "invariant",
      "claim": "French and mixed utterances select qwen, while English and unknown select phonon2; the French utterance goal is exercised by the shared parser.",
      "checkedAt": [
        "grant_agent.neyvia_prompt_dictation.process_prompt",
        "grant_agent.proofs_dictation.check_prompt"
      ],
      "impact": [
        "speech engine routing",
        "local fallback availability"
      ]
    },
    {
      "id": "dictation.stream.preallocation",
      "phase": "pre",
      "claim": "Unknown stream operations, invalid ids, oversized chunks, odd PCM and negative sequences are rejected before any settings lookup, session allocation, timer or speech-engine call.",
      "checkedAt": [
        "grant_agent.neyvia_dictation.stream",
        "grant_agent.proofs_dictation.validate_stream"
      ],
      "impact": [
        "stream sessions",
        "PCM memory",
        "speech engine calls"
      ]
    },
    {
      "checkedAt": [
        "grant_agent.neyvia_dictation_providers.Transcript",
        "grant_agent.neyvia_dictation.stream",
        "grant_agent.proofs_dictation.provider_checks"
      ],
      "claim": "Live words from a streaming provider only grow in order: deltas of the segment being heard stay provisional, a segment locks only when it and every earlier one are complete, and a locked segment is never edited. Checked with the recorded sample fed in 250 ms pieces to a scripted provider.",
      "id": "dictation.provider.partials",
      "impact": [
        "live dictation words",
        "stable/grey split",
        "Voice settings provider choice"
      ],
      "phase": "post"
    },
    {
      "checkedAt": [
        "grant_agent.neyvia_dictation_providers.OpenAIStream.finish",
        "grant_agent.neyvia_dictation.stream",
        "grant_agent.proofs_dictation.provider_checks"
      ],
      "claim": "Release commits the provider's audio, waits for the completed segments, and returns one final text that still goes through the prompt policy and preview.",
      "id": "dictation.provider.finalise",
      "impact": [
        "final dictation text",
        "send preview"
      ],
      "phase": "post"
    },
    {
      "checkedAt": [
        "grant_agent.neyvia_dictation_providers.choose",
        "grant_agent.neyvia_dictation._stream_step",
