{
  "area": "proofs-c-runtime",
  "manuals": [
    "slim-installer",
    "tools-depth"
  ],
  "module": "grant_agent.proofs_c_runtime",
  "self_check": "self_check",
  "contracts": [
    {
      "id": "runtime.install.catalog",
      "phase": "post",
      "claim": "Catalog preserves every package tier and delivery state with exact current core/optional totals.",
      "checkedAt": [
        "grant_agent.install_profiles.InstallProfileRegistry.catalog_snapshot",
        "grant_agent.proofs_c_runtime.check_catalog",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "installation selection",
        "core/optional inventory"
      ]
    },
    {
      "id": "runtime.install.plan",
      "phase": "post",
      "claim": "Plan resolves profile inheritance, optional exclusions and ordered dependency closure; unfinished packages block readiness and execution remains disabled.",
      "checkedAt": [
        "grant_agent.install_profiles.InstallProfileRegistry.resolve",
        "grant_agent.proofs_c_runtime.check_plan",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "installation plan",
        "dependency readiness",
        "execution gate"
      ]
    },
    {
      "id": "runtime.install.cycles",
      "phase": "pre",
      "claim": "Registry rejects package or profile dependency cycles before constructing a selectable registry.",
      "checkedAt": [
        "grant_agent.install_profiles.InstallProfileRegistry._validate",
        "grant_agent.install_profiles.InstallProfileRegistry._cycle_errors",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "installation dependency graph"
      ]
    },
    {
      "id": "runtime.service.spec",
      "phase": "pre",
      "claim": "Service declaration requires explicit loopback HTTP URLs, SHA256 pins, nonempty argv; environment content and inheritance participate in specification identity.",
      "checkedAt": [
        "grant_agent.managed_local_service.ManagedServiceSpec.__post_init__",
        "grant_agent.managed_local_service.ManagedServiceSpec.spec_hash",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "managed child identity",
        "local service lifecycle"
      ]
    },
    {
      "id": "runtime.service.installation",
      "phase": "pre",
      "claim": "Every start validates executable and required-file SHA256 hashes before process creation or reuse.",
      "checkedAt": [
        "grant_agent.managed_local_service.ManagedLocalService.start",
        "grant_agent.managed_local_service.ManagedLocalService._validate_installation",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "local process creation",
        "model and executable bytes"
      ]
    },
    {
      "id": "runtime.service.identity",
      "phase": "invariant",
      "claim": "Running status requires live PID, matching executable and specification, and endpoint health/identity. Foreign or changed identity cannot be stopped.",
      "checkedAt": [
        "grant_agent.managed_local_service.ManagedLocalService.status",
        "grant_agent.managed_local_service.ManagedLocalService._stop_locked",
        "grant_agent.proofs_c_runtime.check_service_status",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "persisted PID",
        "foreign process safety"
      ]
    },
    {
      "id": "runtime.service.lifecycle",
      "phase": "post",
      "claim": "An installed exact healthy process is reused without spawning; an owned new process persists running identity and stops to a zero-PID state.",
      "checkedAt": [
        "grant_agent.managed_local_service.ManagedLocalService.start",
        "grant_agent.managed_local_service.ManagedLocalService._stop_locked",
        "grant_agent.proofs_c_runtime.check_service_status",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "managed lifecycle",
        "service state receipts"
      ]
    },
    {
      "id": "runtime.node.versions",
      "phase": "invariant",
      "claim": "OpenClaw supports Node22 from22.22.3, Node24 from24.15.0 and Node25 from25.9.0 or later; Node23 and None are excluded.",
      "checkedAt": [
        "grant_agent.managed_node_runtime.node_supports_current_openclaw",
        "grant_agent.proofs_c_runtime.check_node_version",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "optional CLI compatibility"
      ]
    },
    {
