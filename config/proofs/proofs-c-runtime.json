      "checkedAt": [
        "grant_agent.memory.MemoryStore.save",
        "grant_agent.proofs_c_runtime.check_memory_saved",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "scratch workspace memory store",
        "resume provenance"
      ]
    },
    {
      "id": "runtime.memory.search",
      "phase": "post",
      "claim": "Search returns positive lexical overlaps ranked by overlap and tag count; empty or absent matches fall back to recent entries and honor the limit.",
      "checkedAt": [
        "grant_agent.memory.MemoryStore.search",
        "grant_agent.proofs_c_runtime.check_memory_search",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "memory retrieval"
      ]
    },
    {
      "id": "runtime.memory.ingest",
      "phase": "post",
      "claim": "Ingestion adds last3 decisions, last2 risks and first2 next actions with exact kinds/tags/session/objective; preserve previous items and return inserted ids in order.",
      "checkedAt": [
        "grant_agent.memory.ingest_state_into_memory",
        "grant_agent.proofs_c_runtime.check_ingested",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "bounded session memory"
      ]
    },
    {
      "id": "runtime.mcp.discovery",
      "phase": "invariant",
      "claim": "Server/search observers omit schemas; describe preserves qualified identity, cached schema and mutability. Codex command-index maps to stdio; SSE remains unavailable with an explicit frontier.",
      "checkedAt": [
        "grant_agent.mcp_broker.McpServerState.compact",
        "grant_agent.mcp_broker.McpOutboundBroker.search",
        "grant_agent.mcp_broker.McpOutboundBroker.describe",
        "grant_agent.proofs_c_runtime.check_mcp_compact",
        "grant_agent.proofs_c_runtime.check_mcp_search",
        "grant_agent.proofs_c_runtime.check_mcp_described",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "progressive discovery",
        "remote schema context",
        "availability"
      ]
    },
    {
      "id": "runtime.mcp.authorization",
      "phase": "pre",
      "claim": "Unauthenticated and unapproved mutating actions cannot dispatch transport calls; success requires dispatch, authenticated state, approval when required and no invalid schema result.",
      "checkedAt": [
        "grant_agent.mcp_broker.McpOutboundBroker.call",
        "grant_agent.proofs_c_runtime.check_mcp_receipt",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "remote read/write authority",
        "operator approvals"
      ]
    },
    {
      "id": "runtime.mcp.receipt",
      "phase": "post",
      "claim": "Every broker action persists its exact returned schema/provider/tool/auth/result/mission receipt under the selected root, including refusal receipts.",
      "checkedAt": [
        "grant_agent.mcp_broker.McpOutboundBroker.call",
        "grant_agent.proofs_c_runtime.check_mcp_receipt",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "action proof receipts",
        "mission artifacts"
      ]
    },
    {
      "id": "runtime.mcp.progressive",
      "phase": "invariant",
      "claim": "Register exactly mcp.servers/search/describe/call; progressive calls use the broker authorization/receipt path. Explicit StubTransport handlers remain simulation.",
      "checkedAt": [
        "grant_agent.mcp_broker.register_with_progressive_surface",
        "grant_agent.mcp_broker.McpOutboundBroker.call",
        "grant_agent.mcp_broker.StubTransport.call_tool",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "model progressive interface",
        "broker tool dispatch"
      ]
    },
    {
      "id": "runtime.mcp.host",
      "phase": "goal",
      "claim": "Neyvia MCP JSON-RPC host lists progressive tools without schemas, forwards qualified calls into the broker and marks approval refusals as MCP errors.",
      "checkedAt": [
        "grant_agent.neyvia_mcp.NeyviaMCPServer.handle",
        "grant_agent.mcp_broker.McpOutboundBroker.call",
        "grant_agent.proofs_c_runtime.check_mcp_receipt",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "incoming MCP host",
        "outbound broker authority",
        "progressive model action"
      ]
    },
    {
      "id": "runtime.toolchain.discovery",
      "phase": "post",
      "claim": "Stable release discovery binds exact asset template, bounded positive size, official GitHub repository URL and SHA256 digest; absence of digest raises before a candidate is returned; summary and signed-release activation policy match all rows.",
      "checkedAt": [
        "grant_agent.marketplace_toolchain.MarketplaceToolchainUpdateManager._check_tool",
        "grant_agent.marketplace_toolchain.MarketplaceToolchainUpdateManager._release_candidate",
        "grant_agent.marketplace_toolchain.MarketplaceToolchainUpdateManager._publish_discovery",
        "grant_agent.proofs_c_runtime.check_toolchain_discovery",
        "grant_agent.proofs_c_runtime.self_check"
      ],
      "impact": [
        "official release candidate selection",
        "no unsigned install activation"
      ]
    },
    {
      "id": "runtime.toolchain.cache",
      "phase": "post",
      "claim": "Published discovery persists exact returned metadata; a fresh schema-compatible cache returns the same rows with cache=hit before any official release fetch.",
      "checkedAt": [
