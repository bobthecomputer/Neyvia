{
  "area": "proofs-c-models",
  "module": "grant_agent.proofs_c_models",
  "self_check": "self_check",
  "manuals": [
    "agents"
  ],
  "contracts": [
    {
      "id": "proofs-c.models.catalog",
      "phase": "invariant",
      "claim": "Model catalogs retain bootstrap family identities, model-specific efforts and labels; observed caches add models, preserve source versions, respect explicit restrictions and deprecation, and compute nonnegative source age.",
      "checkedAt": [
        "model_catalog.build_model_catalog -> proofs_c_models.check_catalog",
        "proofs_c_models.self_check:catalog-bootstrap;catalog-detected;catalog-explicit-restrictions"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.portfolio",
      "phase": "invariant",
      "claim": "Task lanes keep provider-specific Kimi identifiers and efforts separate; recommendation selects the first observed ready route, requiring runner, auth and Kimi profile observations, and never substitutes a provider.",
      "checkedAt": [
        "model_portfolio.build_model_portfolio -> proofs_c_models.checked",
        "proofs_c_models.self_check:portfolio-task-and-auth"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.classification",
      "phase": "invariant",
      "claim": "Tasks select routine, deep or independent verification lanes before provider selection; verification takes precedence over architecture, then bounded work, then caller fallback.",
      "checkedAt": [
        "model_portfolio.classify_task_lane -> proofs_c_models.checked",
        "proofs_c_models.self_check:portfolio-task-and-auth"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.dictation",
      "phase": "invariant",
      "claim": "Dictated route rows preserve specialized roles and provider/model/effort identity; the last role assignment and subsequent effort correction win; CLI prints the same parse receipt.",
      "checkedAt": [
        "model_routing.parse_route_dictation -> proofs_c_models.checked",
        "cli.cmd_route_dictation -> model_routing.parse_route_dictation",
        "proofs_c_models.self_check:dictation-and-cli"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.launch",
      "phase": "invariant",
      "claim": "Launch recommendations retain receipt-bound context reading, canonical independent planner/verifier lanes, the task-selected executor and explicit Cursor runtime/model requests.",
      "checkedAt": [
        "launch_recommendation.build_launch_runtime_recommendation -> proofs_c_models.checked",
        "proofs_c_models.self_check:recommendations-and-modes"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.mode",
      "phase": "invariant",
      "claim": "Mode selection returns exact configured persona, budgets, workers, merge policy and description; unknown names use balanced when present and the bounded default otherwise.",
      "checkedAt": [
        "modes.py: ModeRegistry.get -> proofs_c_models.checked",
        "proofs_c_models.self_check:recommendations-and-modes"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.advisor",
      "phase": "invariant",
      "claim": "Recommendation features follow observed session, verification, resistance, memory, document and approval metrics, priority order and the requested result limit.",
      "checkedAt": [
        "improvement_advisor.recommend_improvements -> proofs_c_models.checked",
        "proofs_c_models.self_check:recommendations-and-modes"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.strict-schema",
      "phase": "invariant",
      "claim": "Strict compilation closes objects, requires every property and represents optional typed fields as nullable without mutating the source; unsupported constructs remain non-strict with warnings.",
      "checkedAt": [
        "model_tool_intelligence.strict_schema -> proofs_c_models.checked",
        "proofs_c_models.self_check:strict-compiler-provider"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.belt",
      "phase": "invariant",
      "claim": "Task compilation selects a bounded ranked belt with immutable execution target, source provenance and bound arguments; selection never grants permission authority.",
      "checkedAt": [
        "model_tool_intelligence.py: ModelToolIntelligence.compile_belt -> proofs_c_models.checked",
        "proofs_c_models.self_check:strict-compiler-provider;live-capability-routing;mcp-progressive-compiler"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.compiler",
      "phase": "invariant",
      "claim": "Every provider callable resolves uniquely to a selected native target with its source provenance and bound arguments; deferred compilation includes tool_search exactly when callable namespaces exist.",
      "checkedAt": [
        "model_tool_intelligence.py: ModelToolIntelligence.compile_openai -> proofs_c_models.checked",
        "proofs_c_models.self_check:strict-compiler-provider"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.resolved",
      "phase": "invariant",
      "claim": "Provider calls resolve uniquely to the saved target; authored payloads nest provider arguments below immutable toolId and unknown functions are rejected.",
      "checkedAt": [
        "model_tool_intelligence.py: ModelToolIntelligence.resolve_openai_call -> proofs_c_models.checked",
        "proofs_c_models.self_check:strict-compiler-provider;adapted-real-stdio"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.provider-request",
      "phase": "invariant",
      "claim": "Responses requests send compiled tools and keep the internal callMap off the provider wire.",
      "checkedAt": [
        "openai_adapter.build_responses_request_from_tool_compiler -> proofs_c_models.checked",
        "proofs_c_models.self_check:strict-compiler-provider"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.loop",
      "phase": "invariant",
      "claim": "Bounded execution never exceeds call limits; approval/auth stops require operator action and persist exact loop state, attempts and durable feedback before returning.",
      "checkedAt": [
        "model_tool_intelligence.py: ModelToolIntelligence.run_bounded -> proofs_c_models.checked",
        "model_tool_intelligence.py: ToolFeedbackStore.record -> proofs_c_models.check_feedback inside durable index transaction",
        "proofs_c_models.self_check:bounded-approval-receipt"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.benchmark",
      "phase": "invariant",
      "claim": "Routing benchmarks derive exact top1/top3/topK accuracy from selected tool identities and persist the same evidence returned to the caller.",
      "checkedAt": [
        "capability_service.py: CapabilityService.benchmark_model_tool_routing -> proofs_c_models.checked",
        "proofs_c_models.self_check:live-capability-routing"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.adapt",
      "phase": "invariant",
      "claim": "Adapted external tools preserve remote identity, source hash, original metadata, provider, server, adapter and licensing provenance before review.",
      "checkedAt": [
        "tool_factory.py: AuthoredToolStore.adapt -> proofs_c_models.checked",
        "proofs_c_models.self_check:adapted-real-stdio"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.authored-save",
      "phase": "invariant",
      "claim": "Only approved valid authored manifests persist; successful save returns the exact recoverable manifest loaded by a fresh store.",
      "checkedAt": [
        "tool_factory.py: AuthoredToolStore.save -> proofs_c_models.checked",
        "proofs_c_models.self_check:adapted-real-stdio"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.authored-execute",
      "phase": "invariant",
      "claim": "Successful adapted execution preserves saved source provenance and validates the external structured output against the authored schema before completion.",
      "checkedAt": [
        "capability_service.py: CapabilityService.execute_authored_tool -> proofs_c_models.checked",
        "proofs_c_models.self_check:adapted-real-stdio"
      ],
      "impact": [
        "model route selection",
        "compiled callable authority",
        "recoverable model receipts"
      ]
    },
    {
      "id": "proofs-c.models.mcp-compiler",
      "phase": "post",
      "claim": "The inbound MCP host omits every full input schema on progressive listing, exposes model.tools.compile and dispatches compiler calls to the model tool belt schema.",
      "checkedAt": [
        "neyvia_mcp.py: NeyviaMCPServer.handle -> proofs_c_models.checked",
        "proofs_c_models.self_check:mcp-progressive-compiler"
      ],
      "impact": [
        "inbound MCP model tooling",
        "progressive tool discovery"
      ]
    }
  ],
