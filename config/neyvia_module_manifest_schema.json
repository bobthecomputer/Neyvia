{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neyvia.local/schemas/module-manifest-v1.json",
  "title": "Neyvia Module Manifest",
  "type": "object",
  "required": [
    "schema",
    "moduleId",
    "version",
    "name",
    "summary",
    "publisher",
    "compatibility",
    "runtime",
    "package",
    "signature",
    "permissions",
    "capabilities",
    "surfaces",
    "distribution",
    "update",
    "context"
  ],
  "properties": {
    "schema": {
      "const": "neyvia.module-manifest/v1"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "publisher": {
      "type": "object",
      "required": ["id", "name", "identity"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["moduleApi", "neyvia"],
      "properties": {
        "moduleApi": {
          "const": "neyvia.module-api/v1"
        },
        "neyvia": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows-x86_64",
              "linux-x86_64",
              "linux-aarch64",
              "macos-x86_64",
              "macos-aarch64",
              "android",
              "ios",
              "web"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["kind", "isolation", "entrypoint"],
      "properties": {
        "kind": {
          "enum": [
            "wasm-component",
            "isolated-service",
            "full-app",
            "content-pack"
          ]
        },
        "isolation": {
          "enum": [
            "wasmtime-wasi",
            "isolated-process",
            "container",
            "bridge-only"
          ]
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "maxLength": 500
        },
        "healthcheck": {
          "type": "object",
          "required": ["kind", "target"],
          "properties": {
            "kind": {
              "enum": ["wasm-call", "http", "ipc", "process-version"]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "archiveSha256",
        "archiveBytes",
        "mediaType"
      ],
      "properties": {
        "archiveSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "mediaType": {
          "const": "application/vnd.neyvia.module+zip"
        },
        "sbomPath": {
          "type": "string",
          "maxLength": 500
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["scheme", "bundlePath", "bundleLocation", "payload"],
      "properties": {
        "scheme": {
          "enum": [
            "sigstore-cosign-bundle",
            "sigstore-cosign-key-bundle"
          ]
        },
        "bundlePath": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "maxLength": 500
        },
        "bundleLocation": {
          "const": "detached"
        },
        "payload": {
          "const": "canonical-manifest"
        },
        "identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "issuer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 160
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "sigstore-cosign-bundle"
              }
            }
          },
          "then": {
            "required": ["identity", "issuer"]
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "sigstore-cosign-key-bundle"
              }
            }
          },
          "then": {
            "required": ["keyId"]
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["permission", "scope", "reason", "required"],
        "properties": {
          "permission": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["moduleId", "version", "required"],
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "name",
          "description",
          "inputSchema",
          "outputSchema"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["surfaceId", "kind", "title", "route"],
        "properties": {
          "surfaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "kind": {
            "enum": ["desktop", "mobile", "web", "embedded", "headless"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "object",
      "required": ["registryRef", "p2pEligible", "pinPolicy"],
      "properties": {
        "registryRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "p2pEligible": {
          "type": "boolean"
        },
        "pinPolicy": {
          "enum": ["publisher-only", "nas-and-installed-peers", "private-mesh"]
        },
        "mirrors": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": ["channel", "rollback", "migrations"],
      "properties": {
        "channel": {
          "enum": ["stable", "beta", "nightly", "project-pinned"]
        },
        "rollback": {
          "type": "boolean"
        },
        "migrations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "migrationId",
              "reversible",
              "requiresApproval",
              "backupStrategy"
            ],
            "properties": {
              "migrationId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.-]+$"
              },
              "reversible": {
                "type": "boolean"
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "backupStrategy": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["summaryIndex", "lazyResources", "maxBootstrapBytes"],
      "properties": {
        "summaryIndex": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
          "maxLength": 500
        },
        "lazyResources": {
          "type": "boolean"
        },
        "maxBootstrapBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
