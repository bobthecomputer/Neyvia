    {
      "glob": "**/*.test.js",
      "reason": "retiring verification code, not application behaviour"
    },
    {
      "glob": "**/*.test.mjs",
      "reason": "retiring verification code, not application behaviour"
    },
    {
      "glob": "**/*.test.jsx",
