    },
    {
      "glob": "**/generated-projects/**",
      "reason": "generated project output; behavior is owned by its generator"
    },
    {
      "glob": "dist/**",
      "reason": "rendered build output; behavior is owned by its source and build contract"
    },
    {
      "glob": "**/dist/**",
      "reason": "rendered build output; behavior is owned by its source and build contract"
    },
    {
      "glob": "vendor/**",
      "reason": "vendored third-party dependency"
    },
    {
      "glob": "**/vendor/**",
      "reason": "vendored third-party dependency"
    },
    {
      "glob": "third_party/**",
      "reason": "third-party dependency source"
    },
    {
      "glob": "**/third_party/**",
      "reason": "third-party dependency source"
    },
    {
      "glob": ".github/workflows/*.yml",
      "reason": "CI workflow configuration"
    },
    {
      "glob": ".github/workflows/*.yaml",
      "reason": "CI workflow configuration"
    }
  ],
  "noBehaviourPaths": {
    "config/neyvia_secret_broker.json": "Private runtime account configuration, never source currency or source browsing",
    "scripts/C1-comparison-run.json": "Recorded proof data or frozen development inputs",
    "config/base_pack/test-manifest.json": "disposable base-pack fixture manifest",
    "config/neyvia_dependency_license_evidence.json": "recorded dependency licensing evidence",
    "config/lesson_regression_seed.json": "frozen lesson regression inputs",
