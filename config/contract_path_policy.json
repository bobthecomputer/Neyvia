    },
    {
      "glob": "config/onboarding_packs/pack.creator-sdk/package.json",
      "generator": "scripts/package_onboarding_packs.py"
    },
    {
      "glob": "config/onboarding_packs/pack.creator-sdk/manifest.json",
      "generator": "scripts/package_onboarding_packs.py"
    },
    {
