{
  "schema": "neyvia.contract-path-policy.v1",
  "noBehaviourGlobs": [
    {
      "glob": "config/onboarding_packs/README.md",
      "reason": "Documentation describing generated onboarding packs"
    }
  ],
  "noBehaviourPrefixes": {
    "proof/": "retained proof artifacts",
    "config/proofs/": "authored verification specifications; changes select their witnesses and require catalog/runner validation, not application execution credit",
    "scripts/evidence/": "evidence and recorded observations",
    "scripts/scroll_vendor/": "upstream vendored qrcode 8.2 and KaTeX sources; consumer outcomes remain behavioural",
    "docs/": "documentation and evidence",
    "plans/": "planning records",
    ".agent_control/": "disposable or retained runtime state",
    ".agents/": "operator instructions",
    ".codex/": "operator skills and instructions",
    ".claude/": "operator instructions",
    ".claude-plugin/": "operator plugin metadata",
    ".neyvia/": "saved local state",
    "tests/": "retiring verification layer; not executed by the release gate",
    "fixtures/": "test inputs",
    "data/": "fixture data",
    "config/base_pack/test-files/": "declared disposable sample inputs",
    "apps/journey-proof-notes-20260923/": "retained disposable journey project",
    "web/a11y/": "recorded accessibility observations",
    "web/proof/": "recorded rendered evidence",
    "src/grant_agent_harness.egg-info/": "generated packaging metadata",
    "config/proofs-a/": "isolated proof fixture manuals",
    "config/paul_intent/": "frozen task and preference corpus",
    "config/evolver/": "frozen evaluation and mutation data",
    "tools/laya/question_sets/": "frozen evaluation question inputs",
    "config/c13/": "frozen visual evaluation input corpus"
  },
  "noBehaviourNames": [
    "package-lock.json",
    "uv.lock",
    "Cargo.lock",
    ".gitignore",
    ".gitattributes",
    "LICENSE",
    "NOTICE",
    "PKG-INFO",
    "LICENSE-laya",
    "ts-fsrs.LICENSE",
    "NOTICES"
  ],
  "noBehaviourExtensions": [
    ".md",
    ".txt",
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".gif",
    ".ico",
    ".svg",
    ".pdf",
    ".wav",
    ".mp3",
    ".mp4",
    ".ogg",
    ".ttf",
    ".woff",
    ".woff2",
    ".zip",
    ".tar",
    ".gz",
    ".bin",
