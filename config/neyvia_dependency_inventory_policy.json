{
  "schema": "neyvia.dependency-inventory-policy/v1",
  "ownership": {
    "installPackages": {
      "owner": "neyvia-product-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    },
    "npm": {
      "owner": "neyvia-web-runtime-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    },
    "python": {
      "owner": "neyvia-agent-runtime-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    },
    "desktopRust": {
      "owner": "neyvia-desktop-runtime-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    },
    "irohCacheRust": {
      "owner": "neyvia-mesh-runtime-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    },
    "managedTools": {
      "owner": "neyvia-capability-maintainers",
      "updateResponsibility": "neyvia-release-engineering"
    }
  },
  "classification": {
    "npmProduction": "core",
    "npmDevelopment": "optional",
    "pythonProduction": "core",
    "pythonDevelopment": "optional",
    "desktopRust": "core",
    "irohCacheRust": "optional"
  },
  "criticalFields": [
    "owner",
    "license",
    "updateResponsibility"
  ],
  "criticalClassification": "core",
  "installedSizePolicy": "record-only-when-a-checked-in-installed-size-measurement-exists",
  "licensePolicy": "copy-only-explicit-local-declarations-never-infer-or-query"
}
